#include "kernel_operator.h"
#include "sinkhorn_norm/tiling_data.h"
#include "sinkhorn_norm/tiling_key.h"
#include "sinkhorn_norm/common/primitives.h"
#include "sinkhorn_norm/kernels/f12_wide_blocked.h"
#include "sinkhorn_norm/kernels/f14_wide_rotating128.h"
#include "sinkhorn_norm/kernels/f09_medium_dense_io.h"
#include "sinkhorn_norm/kernels/f04_narrow_single.h"
#include "sinkhorn_norm/kernels/f01_tiny_split.h"
#include "sinkhorn_norm/kernels/f13_wide_compact_five.h"
#include "sinkhorn_norm/kernels/f11_medium_aligned_64.h"
#include "sinkhorn_norm/kernels/f08_narrow_p24_recurrent.h"
#include "sinkhorn_norm/kernels/f10_medium_compact.h"
#include "sinkhorn_norm/kernels/f05_narrow_p16_short_batch.h"
#include "sinkhorn_norm/kernels/f06_narrow_p16_paired_rows.h"
#include "sinkhorn_norm/kernels/f07_narrow_p16_dense_io.h"
#include "sinkhorn_norm/kernels/f02_tiny_single.h"
#include "sinkhorn_norm/kernels/f03_tiny_token_planes.h"
#include "sinkhorn_norm/kernels/f00_general_fallback.h"

namespace {

bool TryLaunchWideForecast(uint32_t blocks, void *stream, uint8_t *mixes,
                           uint8_t *pre, uint8_t *post, uint8_t *comb,
                           const sinkhorn_norm::TilingData &t);

template <sinkhorn_norm::TilingKey Key>
inline void LaunchTilingKey(uint32_t blocks, void *stream, uint8_t *mixes,
                            uint8_t *pre, uint8_t *post, uint8_t *comb,
                            const sinkhorn_norm::TilingData &t) {
  constexpr auto family = sinkhorn_norm::FamilyOf(Key);
  constexpr auto variant = sinkhorn_norm::VariantOf(Key);
  if constexpr (family == sinkhorn_norm::KernelFamily::F12_WideBlocked) {
    sinkhorn_f12_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F14_WideRotating128) {
    sinkhorn_f14_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F09_MediumDenseIo) {
    sinkhorn_f09_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F04_NarrowSingle) {
    sinkhorn_f04_kernel<variant><<<blocks, nullptr, stream>>>(
        mixes, pre, post, comb, t);
  } else if constexpr (family == sinkhorn_norm::KernelFamily::F01_TinySplit) {
    sinkhorn_f01_kernel<variant><<<blocks, nullptr, stream>>>(
        mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F13_WideQuarterStream) {
    if (!TryLaunchWideForecast(blocks, stream, mixes, pre, post, comb, t))
      sinkhorn_f13_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F11_MediumAligned64) {
    sinkhorn_f11_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F08_NarrowP24Recurrent) {
    if (sinkhorn_norm::UsesP24SharedGate(t)) {
      const sinkhorn_norm::P24SharedArgs args{t.eps,t.iters,t.h,
          static_cast<uint32_t>(t.token_count),t.tile_tokens};
      sinkhorn_f08_kernel<1><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);
    } else
      sinkhorn_f08_kernel<0><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F10_MediumCompact) {
    const sinkhorn_norm::MediumCompactArgs args{
        t.tokens_per_core, t.eps, t.iters, t.h, t.input_bytes,
        t.extra_core_count, t.tile_tokens};
    sinkhorn_f10_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F05_NarrowP16ShortBatch) {
    const sinkhorn_norm::ShortNarrowArgs args{
        t.eps, t.iters, t.h, static_cast<uint32_t>(t.tokens_per_core), t.extra_core_count};
    sinkhorn_f05_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F06_NarrowP16PairedRows) {
    sinkhorn_f06_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F07_NarrowP16DenseIo) {
    const sinkhorn_norm::NarrowDenseArgs args{
        t.tokens_per_core, t.eps, t.iters, t.h, t.extra_core_count, t.tile_tokens};
    if constexpr (variant == sinkhorn_norm::kNarrowDenseFactorVariant) {
      sinkhorn_f07_factor_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);
    } else {
      sinkhorn_f07_kernel<variant><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);
    }
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F02_TinySingle) {
    if constexpr (variant == 3) {
      if (sinkhorn_norm::UsesTinyThreeRow(t)) {
        const sinkhorn_norm::TinyThreeRowArgs args{t.eps, t.iters,
            static_cast<uint32_t>(t.token_count)};
        sinkhorn_f02_kernel<variant><<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, args);
        return;
      }
    }
    if constexpr (variant >= 4) {
      if (t.iters >= 14 && t.eps >= 0x1p-24f && t.eps <= 0x1p-10f) {
        sinkhorn_f02_long_kernel<variant><<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, t);
        return;
      }
    }
    sinkhorn_f02_kernel<variant><<<blocks, nullptr, stream>>>(
        mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F03_TinyTokenPlanes) {
    sinkhorn_f03_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  } else if constexpr (family ==
                       sinkhorn_norm::KernelFamily::F00_GeneralFallback) {
    sinkhorn_f00_kernel<variant><<<blocks, nullptr, stream>>>(
        mixes, pre, post, comb, t);
  } else {
    static_assert(Key == 0, "Unsupported direct-launch tiling key");
  }
}

}  // namespace

extern "C" void sinkhorn_norm_enqueue(uint32_t blocks, void *stream,
                                      uint8_t *mixes, uint8_t *pre,
                                      uint8_t *post, uint8_t *comb,
                                      sinkhorn_norm::TilingData tiling,
                                      sinkhorn_norm::TilingKey key) {
  switch (key) {
#define SINKHORN_LAUNCH_KEY(Family, Variant)                                  \
  case sinkhorn_norm::KeyOf(sinkhorn_norm::KernelFamily::Family, Variant):    \
    LaunchTilingKey<sinkhorn_norm::KeyOf(sinkhorn_norm::KernelFamily::Family, \
                                         Variant)>(blocks, stream, mixes,     \
                                                   pre, post, comb, tiling);  \
    return;
    SINKHORN_TILING_KEY_CASES(SINKHORN_LAUNCH_KEY)
#undef SINKHORN_LAUNCH_KEY
  }
}

namespace {

bool TryLaunchWideForecast(uint32_t blocks, void *stream, uint8_t *mixes,
                           uint8_t *pre, uint8_t *post, uint8_t *comb,
                           const sinkhorn_norm::TilingData &t) {
  const auto qr = sinkhorn_norm::MakeCompactFiveLayout(t.h, t.h_pad, t.tile_tokens).quarter_rows;
  const auto rows = 4 * qr;
  const uint64_t span = uint64_t{t.h_pad} * t.tile_tokens;
  const auto length = rows + (span + 63) / 64 * 64;
  const auto columnTop = (span + 127) / 128 * 128 + 64 + (span + 63) / 64 * 64;
  const auto historyStart = 8 * qr > columnTop ? 8 * qr : columnTop;
  if (t.iters < 31 || t.eps < 0x1p-24f || t.eps > 1.0e-5f || qr % 16 != 0 ||
      historyStart + 2 * length > 8 * rows || sinkhorn_norm::f13::kWideForecastSteps * length + 64 > qr * t.h_pad)
    return false;
  sinkhorn_f13_forecast_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);
  return true;
}

}  // namespace
