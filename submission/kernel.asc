__ubuf__ float *gates,__ubuf__ float *tmp,__ubuf__ float *ones,uint32_t span,float eps){if ASCEND_IS_AIV {const uint32_t n = 2 * span;const uint32_t gateRepeats = (n + 63)/ 64;const uint32_t spanRepeats = (span + 63)/ 64;const uint32_t spanFull = span / 64;const uint32_t spanTail = span % 64;SetMaskNorm();WideRoundMask(~uint64_t{0});vmuls(tmp,gates,-1.0f,gateRepeats,1,1,8,8);pipe_barrier(PIPE_V);vmins(tmp,tmp,80.0f,gateRepeats,1,1,8,8);pipe_barrier(PIPE_V);vexp(tmp,tmp,gateRepeats,1,1,8,8);pipe_barrier(PIPE_V);vadds(tmp,tmp,1.0f,gateRepeats,1,1,8,8);pipe_barrier(PIPE_V);vdiv(gates,ones,tmp,gateRepeats,1,1,1,8,8,8);pipe_barrier(PIPE_V);if (spanFull != 0){vadds(gates,gates,eps,spanFull,1,1,8,8);}if (spanTail != 0){WideRoundMask((uint64_t{1}<< spanTail)- 1);vadds(gates + spanFull * 64,gates + spanFull * 64,eps,1,1,1,8,8);WideRoundMask(~uint64_t{0});}vmuls(gates + span,gates + span,2.0f,spanRepeats,1,1,8,8);pipe_barrier(PIPE_V);ResetMask();}}static __aicore__ __attribute__((always_inline))inline void RunNarrowPairedCompleteRounds(
