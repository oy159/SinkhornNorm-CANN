 dst=block==0 ? result_:partial_[(block-1)*rp];if(groups!=0){BlockReduceSum(dst,matrix_[col],SN_SC<int32_t>(groups),mask,1,SN_SC<int32_t>(blocks),SN_SC<int32_t>(t_.h_pad));}}SN_VB;for(SN_U32 first=0;first<rows_;first+=64){const SN_U64 width=rows_-first<64 ? rows_-first:64;auto dst=result_[first];Add(dst,partial_[first],dst,width,SN_SC<uint8_t>(blocks-1),{1,1,1,0,SN_SC<uint8_t>(rp/8),0});}SN_VB;}SN_AI void BroadcastRows(){Brcb(tmp_,result_,SN_SC<uint8_t>((rows_+7)/8),{1,8});SN_VB;}template<bool Subtract>
SN_AI void ApplyRows(){const auto blockStride=SN_SC<uint8_t>(t_.h_pad/8);const auto repeatStride=SN_SC<uint8_t>(t_.h_pad);const auto groups=SN_SC<uint8_t>(rows_/8);for(SN_U32 col=0;col<t_.h;col+=8){const SN_U32 width=t_.h-col<8 ? t_.h-col:8;SN_U64 mask[2]={((SN_U64{1}<<width)-1)*SN_U64{0x0101010101010101},0};auto m=matrix_[col];if(groups!=0){if constexpr(Subtract){Sub(m,m,tmp_,mask,groups,{blockStride,blockStride,1,repeatStride,repeatStride,8});}else{Mul(m,m,tmp_,mask,groups,{blockStride,blockStride,1,repeatStride,repeatStride,8});}}}SN_VB;}SN_AI void Softmax(){BroadcastRows();ApplyRows<true>();Exp(matrix_,matrix_,rows_*t_.h_pad);SN_VB;RowSums();Div(result_,ones_,result_,rows_);SN_VB;BroadcastRows();ApplyRows<false>();Adds(matrix_,matrix_,t_.eps,rows_*t_.h_pad);SN_VB;}template<bool Materialize=true>
