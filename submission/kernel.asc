#include "kernel_operator.h"
namespace {bool TryLaunchWideForecast(uint32_t blocks, void *stream, uint8_t *mixes,uint8_t *pre, uint8_t *post, uint8_t *comb,const sinkhorn_norm::TilingData &t);template <sinkhorn_norm::TilingKey Key>
inline void LaunchTilingKey(uint32_t blocks, void *stream, uint8_t *mixes,uint8_t *pre, uint8_t *post, uint8_t *comb,const sinkhorn_norm::TilingData &t) {constexpr auto family = sinkhorn_norm::FamilyOf(Key);constexpr auto variant = sinkhorn_norm::VariantOf(Key);if constexpr (family == sinkhorn_norm::KernelFamily::F12_WideBlocked) {sinkhorn_f12_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F14_WideRotating128) {sinkhorn_f14_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F09_MediumDenseIo) {sinkhorn_f09_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F04_NarrowSingle) {sinkhorn_f04_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, t);} else if constexpr (family == sinkhorn_norm::KernelFamily::F01_TinySplit) {sinkhorn_f01_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F13_WideQuarterStream) {if (!TryLaunchWideForecast(blocks, stream, mixes, pre, post, comb, t))
sinkhorn_f13_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F11_MediumAligned64) {sinkhorn_f11_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F08_NarrowP24Recurrent) {if (sinkhorn_norm::UsesP24SharedGate(t)) {const sinkhorn_norm::P24SharedArgs args{t.eps,t.iters,t.h,static_cast<uint32_t>(t.token_count),t.tile_tokens};sinkhorn_f08_kernel<1><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);} else
sinkhorn_f08_kernel<0><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F10_MediumCompact) {const sinkhorn_norm::MediumCompactArgs args{t.tokens_per_core, t.eps, t.iters, t.h, t.input_bytes,t.extra_core_count, t.tile_tokens};sinkhorn_f10_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F05_NarrowP16ShortBatch) {const sinkhorn_norm::ShortNarrowArgs args{t.eps, t.iters, t.h, static_cast<uint32_t>(t.tokens_per_core), t.extra_core_count};sinkhorn_f05_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F06_NarrowP16PairedRows) {sinkhorn_f06_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F07_NarrowP16DenseIo) {const sinkhorn_norm::NarrowDenseArgs args{t.tokens_per_core, t.eps, t.iters, t.h, t.extra_core_count, t.tile_tokens};if constexpr (variant == sinkhorn_norm::kNarrowDenseFactorVariant) {sinkhorn_f07_factor_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);} else {sinkhorn_f07_kernel<variant><<<blocks, nullptr, stream>>>(mixes, pre, post, comb, args);}} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F02_TinySingle) {if constexpr (variant == 3) {if (sinkhorn_norm::UsesTinyThreeRow(t)) {const sinkhorn_norm::TinyThreeRowArgs args{t.eps, t.iters,static_cast<uint32_t>(t.token_count)};sinkhorn_f02_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, args);return;}}if constexpr (variant >= 4) {if (t.iters >= 14 && t.eps >= 0x1p-24f && t.eps <= 0x1p-10f) {sinkhorn_f02_long_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, t);return;}}sinkhorn_f02_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F03_TinyTokenPlanes) {sinkhorn_f03_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);} else if constexpr (family ==
sinkhorn_norm::KernelFamily::F00_GeneralFallback) {sinkhorn_f00_kernel<variant><<<blocks, nullptr, stream>>>(
mixes, pre, post, comb, t);} else {static_assert(Key == 0, "Unsupported direct-launch tiling key");}}}  // namespace
extern "C" void sinkhorn_norm_enqueue(uint32_t blocks, void *stream,uint8_t *mixes, uint8_t *pre,uint8_t *post, uint8_t *comb,sinkhorn_norm::TilingData tiling,sinkhorn_norm::TilingKey key) {switch (key) {
#define SINKHORN_LAUNCH_KEY(Family, Variant)                                  \
case sinkhorn_norm::KeyOf(sinkhorn_norm::KernelFamily::Family, Variant):    \
LaunchTilingKey<sinkhorn_norm::KeyOf(sinkhorn_norm::KernelFamily::Family, \
Variant)>(blocks, stream, mixes,     \
pre, post, comb, tiling);  \
return;
SINKHORN_TILING_KEY_CASES(SINKHORN_LAUNCH_KEY)
#undef SINKHORN_LAUNCH_KEY
}}namespace {bool TryLaunchWideForecast(uint32_t blocks, void *stream, uint8_t *mixes,uint8_t *pre, uint8_t *post, uint8_t *comb,const sinkhorn_norm::TilingData &t) {const auto qr = sinkhorn_norm::MakeCompactFiveLayout(t.h, t.h_pad, t.tile_tokens).quarter_rows;const auto rows = 4 * qr;const uint64_t span = uint64_t{t.h_pad} * t.tile_tokens;const auto length = rows + (span + 63) / 64 * 64;const auto columnTop = (span + 127) / 128 * 128 + 64 + (span + 63) / 64 * 64;const auto historyStart = 8 * qr > columnTop ? 8 * qr : columnTop;if (t.iters < 31 || t.eps < 0x1p-24f || t.eps > 1.0e-5f || qr % 16 != 0 ||
historyStart + 2 * length > 8 * rows || sinkhorn_norm::f13::kWideForecastSteps * length + 64 > qr * t.h_pad)
return false;sinkhorn_f13_forecast_kernel<<<blocks, nullptr, stream>>>(mixes, pre, post, comb, t);return true;}}  // namespace


#include "tiling/platform/platform_ascendc.h"
#include <algorithm>
#include <cstdint>
#include <limits>
extern "C" void sinkhorn_norm_enqueue(SN_U32 blocks,void*stream,uint8_t*mixes,uint8_t*pre,uint8_t*post,uint8_t*comb,sinkhorn_norm::TilingData tiling,sinkhorn_norm::TilingKey key);namespace sinkhorn_norm{bool QueryPlatformResources(PlatformResources&resources,std::string&error)
{resources={};error.clear();
#if defined(ASCENDC_CPU_DEBUG)&& defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
auto*platform=platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1");
#else
auto*platform=platform_ascendc::PlatformAscendCManager::GetInstance();
#endif
if(platform==nullptr){error="CANN platform is unavailable; initialize ACL and select a device first";return false;}resources.aiv_cores=platform->GetCoreNumAiv();platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,resources.ub_bytes);if(resources.aiv_cores==0||resources.ub_bytes==0){error="CANN returned an empty AIV/UB resource description";return false;}return true;}bool Launch(const Problem&problem,const DeviceBuffers&buffers,void*stream,std::string&error)
{return Launch(problem,buffers,stream,std::numeric_limits<SN_U64>::max(),error);}bool Launch(const Problem&problem,const DeviceBuffers&buffers,void*stream,SN_U64 core_limit,std::string&error)
{if(core_limit==0){error="available vector core count must be positive";return false;}if(!buffers.mixes||!buffers.pre||!buffers.post||!buffers.comb){error="all four device buffers are required";return false;}PlatformResources resources{};if(!QueryPlatformResources(resources,error)){return false;}resources.aiv_cores=SN_SC<SN_U32>(
std::min<SN_U64>(resources.aiv_cores,core_limit));LaunchPlan plan{};OutputShapes shapes{};if(!MakeLaunchPlan(problem,resources,plan,shapes,error)){return false;}const auto&tiling=plan.data;const void*pointers[]={buffers.mixes,buffers.pre,buffers.post,buffers.comb};const SN_U64 gateBytes=tiling.token_count*tiling.h*sizeof(float);const SN_U64 sizes[]={tiling.token_count*tiling.input_width*sizeof(float),gateBytes,gateBytes,gateBytes*tiling.h};uintptr_t begin[4]{};uintptr_t end[4]{};for(unsigned i=0;i<4;++i){begin[i]=SN_RC<uintptr_t>(pointers[i]);if(sizes[i]>std::numeric_limits<uintptr_t>::max()-begin[i]){error="device buffer address range overflows";return false;}end[i]=begin[i]+SN_SC<uintptr_t>(sizes[i]);for(unsigned j=0;j<i;++j){if(begin[i]<end[j]&&begin[j]<end[i]){error="input and output device buffer ranges must be disjoint";return false;}}}sinkhorn_norm_enqueue(plan.blocks,stream,SN_SC<uint8_t*>(buffers.mixes),SN_SC<uint8_t*>(buffers.pre),SN_SC<uint8_t*>(buffers.post),SN_SC<uint8_t*>(buffers.comb),tiling,plan.key);return true;}}


#include <stdexcept>
namespace{const TensorInfo&SinkhornRequireTensor(const TensorGroupInfo&group,int64_t rank,const char*name)
{if(group.numTensors!=1||group.tensors==nullptr){throw std::invalid_argument(std::string(name)+": expected one tensor");}const TensorInfo&tensor=group.tensors[0];if(tensor.numDims!=rank||tensor.shape==nullptr||tensor.dtype!=0){throw std::invalid_argument(std::string(name)+": expected FP32 tensor with correct rank");}return tensor;}void SinkhornRequireOutput(const TensorGroupInfo&group,int64_t rank,int64_t b,int64_t s,int64_t h,const char*name)
{const auto&tensor=SinkhornRequireTensor(group,rank,name);if(tensor.shape[0]!=b||tensor.shape[1]!=s||tensor.shape[2]!=h||
(rank==4&&tensor.shape[3]!=h)){throw std::invalid_argument(std::string(name)+": output shape mismatch");}}}extern "C" void run_kernel(
GM_ADDR mixes,const TensorGroupInfo&info_mixes,GM_ADDR pre,const TensorGroupInfo&info_pre,GM_ADDR post,const TensorGroupInfo&info_post,GM_ADDR comb,const TensorGroupInfo&info_comb,int64_t availableCoreNum,aclrtStream stream,int64_t hc_mult,int64_t hc_sinkhorn_iters,float eps)
{const auto&input=SinkhornRequireTensor(info_mixes,3,"mixes");if(availableCoreNum<=0){throw std::invalid_argument("availableCoreNum must be positive");}sinkhorn_norm::Problem problem{};for(unsigned i=0;i<3;++i){problem.shape[i]=input.shape[i];}problem.h=hc_mult;problem.iters=hc_sinkhorn_iters;problem.eps=eps;SinkhornRequireOutput(info_pre,3,problem.shape[0],problem.shape[1],hc_mult,"pre");SinkhornRequireOutput(info_post,3,problem.shape[0],problem.shape[1],hc_mult,"post");SinkhornRequireOutput(info_comb,4,problem.shape[0],problem.shape[1],hc_mult,"comb");const sinkhorn_norm::DeviceBuffers buffers{mixes,pre,post,comb};std::string error;if(!sinkhorn_norm::Launch(problem,buffers,stream,SN_SC<SN_U64>(availableCoreNum),error)){throw std::invalid_argument(error);}}
