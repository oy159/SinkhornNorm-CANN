4*p +(i/2)*32+(i%2)*8+phase*16].GetPhyAddr());}TransDataTo5HD<float>(dst,src,param);}SN_VB;}SN_AI void Normalize(SN_U32 p){if ASCEND_IS_AIV{auto gates=SN_RC<SN_UB*>(planes_.GetPhyAddr());auto a=gates+4*p;auto b=a+p;auto c=b+p;auto d=c+p;auto scratch=SN_RC<SN_UB*>(dense_.GetPhyAddr());auto ratios=scratch+4*p;auto ones=scratch+6*p;auto u=scratch+64;auto v=u+p;auto w=v+p;SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});vector_dup(ones,1.0f,1,1,1,8,0);SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,4*p);vmuls(scratch,gates,-1.0f,1,1,1,8,8);SN_VM<float,MaskMode::COUNTER>(0,p);vsub(ratios,b,a,1,1,1,1,8,8,8);vsub(ratios+p,d,c,1,1,1,1,8,8,8);SN_V;SN_VM<float,MaskMode::COUNTER>(0,6*p);vmins(scratch,scratch,80.0f,1,1,1,8,8);SN_V;vexp(scratch,scratch,1,1,1,8,8);SN_V;SN_VM<float,MaskMode::COUNTER>(0,4*p);vadds(scratch,scratch,1.0f,1,1,1,8,8);SN_VM<float,MaskMode::COUNTER>(0,p);vadds(b,ratios,1.0f,1,1,1,8,8);vadds(d,ratios+p,1.0f,1,1,1,8,8);SN_V;SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});vdiv(gates,ones,scratch,4*p/64,1,1,1,8,0,8);vdiv(a,ones,b,p/64,1,1,1,8,0,8);vdiv(c,ones,d,p/64,1,1,1,8,0,8);SN_V;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,2*p);vadds(gates,gates,t_.eps,1,1,1,8,8);vmuls(gates+2*p,gates+2*p,2.0f,1,1,1,8,8);SN_VM<float,MaskMode::COUNTER>(0,p);vmul(b,ratios,a,1,1,1,1,8,8,8);vmul(d,ratios+p,c,1,1,1,1,8,8,8);SN_V;SN_VM<float,MaskMode::COUNTER>(0,4*p);vadds(a,a,t_.eps,1,1,1,8,8);SN_V;SN_VM<float,MaskMode::COUNTER>(0,p);vadds(u,a,t_.eps,1,1,1,8,8);vadds(v,b,t_.eps,1,1,1,8,8);SN_V;vadd(u,u,c,1,1,1,1,8,8,8);vadd(v,v,d,1,1,1,1,8,8,8);SN_V;Divide(a,b,c,d,u,v,true);for(SN_U32 iter=1;iter<t_.iters;++iter){vadd(u,a,b,1,1,1,1,8,8,8);vadd(v,c,d,1,1,1,1,8,8,8);SN_V;vadds(u,u,t_.eps,1,1,1,8,8);vadds(v,v,t_.eps,1,1,1,8,8);SN_V;vmul(a,a,v,1,1,1,1,8,8,8);vmul(b,b,v,1,1,1,1,8,8,8);vmul(c,c,u,1,1,1,1,8,8,8);vmul(d,d,u,1,1,1,1,8,8,8);vmul(w,u,v,1,1,1,1,8,8,8);SN_V;vadd(u,a,c,1,1,1,1,8,8,8);vadd(v,b,d,1,1,1,1,8,8,8);vmuls(w,w,t_.eps,1,1,1,8,8);SN_V;vadd(u,u,w,1,1,1,1,8,8,8);vadd(v,v,w,1,1,1,1,8,8,8);SN_V;Divide(a,b,c,d,u,v,true);}SetMaskNorm();ResetMask();}}SN_AI void Divide(SN_UB*a,SN_UB*b,SN_UB*c,SN_UB*d,SN_UB*u,SN_UB*v,bool column){if ASCEND_IS_AIV{vdiv(a,a,u,1,1,1,1,8,8,8);vdiv(b,b,column ? v:u,1,1,1,1,8,8,8);vdiv(c,c,column ? u:v,1,1,1,1,8,8,8);vdiv(d,d,v,1,1,1,1,8,8,8);SN_V;}}TPipe pipe_;TBuf<TPosition::VECCALC>denseBuffer_,planeBuffer_;GlobalTensor<float>input_,pre_,post_,comb_;LocalTensor<float>dense_,denseBase_,planes_;TilingData t_;SN_U32 cap_;SN_U64 start_,count_;bool pipelined_;};}}
