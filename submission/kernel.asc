SN_INL void RunPackedSerialRoundsP24(
SN_UB*matrix,SN_UB*tmp,SN_UB*result,SN_UB*columns,SN_UB*denom,SN_UB*work,float eps,SN_U32 rounds){static_assert(H>=17&&H<=24,"Use the static P24 family");if ASCEND_IS_AIV{constexpr SN_U64 rowMask=(SN_U64{1}<<H)-1;constexpr SN_U64 tailMask=
((SN_U64{1}<<(H-16))-1)*SN_U64{0x0101010101010101};SetMaskNorm();for(SN_U32 round=0;round<rounds;++round){SN_VM<float,MaskMode::NORMAL>(SN_U64{0},~SN_U64{0});vadd(tmp,matrix,matrix+8,3,1,3,3,8,24,24);SN_V;SN_VM<float,MaskMode::NORMAL>(SN_U64{0},tailMask);vadd(tmp,tmp,matrix+16,3,1,1,3,8,8,24);SN_V;SN_VM<float,MaskMode::NORMAL>(SN_U64{0},~SN_U64{0});vcgadd(result,tmp,3,1,1,8);SN_V;SN_VM<float,MaskMode::NORMAL>(SN_U64{0},rowMask);vadds(result,result,eps,1,1,1,8,8);SN_V;SN_VM<float,MaskMode::NORMAL>(SN_U64{0},~SN_U64{0});vbrcb(SN_RC<__ubuf__ SN_U32*>(columns),SN_RC<__ubuf__ SN_U32*>(result),1,8,3);SN_VM<float,MaskMode::NORMAL>(SN_U64{0},rowMask);if constexpr(H%2==0){SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<24)-1);vector_dup(denom,eps,1,1,1,8,0);vector_dup(work,0.0f,1,1,1,8,0);}else{vector_dup(denom,eps,1,1,1,8,0);SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<48)-1);vector_dup(tmp,0.0f,1,1,1,8,0);}SN_V;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(SN_U64{0},SN_U64{H*8});for(SN_U32 block=0;block<3;++block){vdiv(matrix+8*block,matrix+8*block,columns,1,3,3,1,24,24,8);}SN_V;SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<48)-1);auto*partial=H%2==0 ? work:tmp;vadd(partial,matrix,partial,H/2,1,1,1,0,6,0);if constexpr(H%2!=0){SN_VM<float,MaskMode::NORMAL>(0,rowMask);vadd(denom,matrix+(H-1)*24,denom,1,1,1,1,8,8,8);}SN_V;SN_VM<float,MaskMode::NORMAL>(0,rowMask);if constexpr(H%2==0){vadd(denom,work,denom,1,1,1,1,8,8,8);}else{vadd(denom,tmp,denom,2,1,1,1,0,3,0);}SN_V;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(SN_U64{0},SN_U64{H*8});for(SN_U32 block=0;block<3;++block){vdiv(matrix+8*block,matrix+8*block,denom+8*block,1,3,3,0,24,24,0);}SN_V;SetMaskNorm();}ResetMask();}}template<SN_U32 StaticH>
class NarrowSingleP24Kernel{static_assert(StaticH>=17&&StaticH<=24,"Complete fixed P24 family");static constexpr SN_U32 P=24;static constexpr SN_U32 kTileBytes=
4*StaticH*P +((4*(P -StaticH)*P +511)/512)*512+8*P;public:
SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,float eps,SN_U32 iters){eps_=eps;iters_=iters;constexpr SN_U32 width=StaticH-16;packedRowMask_[0]=
((SN_U64{1}<<width)-1)*SN_U64{0x0101010101010101};packedRowMask_[1]=0;inputGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));preGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));postGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));combGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));matrix_=LocalTensor<float>(TPosition::VECOUT,0,kTileBytes/4);tmp_=LocalTensor<float>(TPosition::VECCALC,kTileBytes,8*P);work_=LocalTensor<float>(TPosition::VECCALC,kTileBytes+32*P,P);denom_=LocalTensor<float>(TPosition::VECCALC,kTileBytes+36*P,P);result_=LocalTensor<float>(TPosition::VECCALC,kTileBytes+40*P,P);columns_=
LocalTensor<float>(TPosition::VECCALC,kTileBytes+44*P,P*P);Duplicate(denom_,1.0f,P);Duplicate(result_,0.0f,P);SN_VB;}SN_AI void Process(){const SN_U64 token=GetBlockIdx();constexpr SN_U32 inputWidth=StaticH*(StaticH+2);const DataCopyPadExtParams<float>pad{true,0,SN_SC<uint8_t>(P -StaticH),0.0f};const DataCopyExtParams copy{SN_SC<uint16_t>(StaticH+2),StaticH*SN_U32{sizeof(float)},0,0,0};DataCopyPad(matrix_,inputGm_[token*inputWidth],copy,pad);Sync<HardEvent::MTE2_V>();if constexpr(StaticH<P){Duplicate(matrix_[2*P +StaticH*P],0.0f,(P -StaticH)*P);}GatePair();Softmax();NormalizeColumns();SN_VB;RunPackedSerialRoundsP24<StaticH>(
SN_RC<SN_UB*>(matrix_.GetPhyAddr())+2*P,SN_RC<SN_UB*>(tmp_.GetPhyAddr()),SN_RC<SN_UB*>(result_.GetPhyAddr()),SN_RC<SN_UB*>(columns_.GetPhyAddr()),SN_RC<SN_UB*>(denom_.GetPhyAddr()),SN_RC<SN_UB*>(work_.GetPhyAddr()),eps_,iters_-1);Sync<HardEvent::V_MTE3>();const DataCopyExtParams gateCopy{1,StaticH*SN_U32{sizeof(float)},0,0,0};DataCopyPad(preGm_[token*StaticH],matrix_,gateCopy);DataCopyPad(postGm_[token*StaticH],matrix_[P],gateCopy);const DataCopyExtParams matrixCopy{SN_SC<uint16_t>(StaticH),StaticH*SN_U32{sizeof(float)},0,0,0};DataCopyPad(combGm_[token*StaticH*StaticH],matrix_[2*P],matrixCopy);Sync<HardEvent::MTE3_MTE2>();}private:
template<HardEvent event>
SN_AI void Sync(){SetFlag<event>(EVENT_ID0);WaitFlag<event>(EVENT_ID0);}SN_AI void GatePair(){constexpr SN_U32 count=2*P;auto absExp=tmp_;auto numerator=tmp_[count];auto denominator=tmp_[2*count];Muls(absExp,matrix_,-1.0f,count);Duplicate(numerator,1.0f,count);Mins(absExp,absExp,80.0f,count);Exp(absExp,absExp,count);Adds(denominator,absExp,1.0f,count);Div(matrix_,numerator,denominator,count);Adds(matrix_,matrix_,eps_,StaticH);Muls(matrix_[P],matrix_[P],2.0f,StaticH);}template<bool Maximum>
SN_AI void ReduceRows(){if constexpr(Maximum){Max(tmp_,matrix_[2*P],matrix_[2*P +8],SN_U64{64},uint8_t{3},{1,3,3,8,24,24});Max(tmp_,tmp_,matrix_[2*P +16],packedRowMask_,uint8_t{3},{1,1,3,8,8,24});BlockReduceMax(result_,tmp_,int32_t{3},int32_t{64},1,1,8);}else{Add(tmp_,matrix_[2*P],matrix_[2*P +8],SN_U64{64},uint8_t{3},{1,3,3,8,24,24});Add(tmp_,tmp_,matrix_[2*P +16],packedRowMask_,uint8_t{3},{1,1,3,8,8,24});BlockReduceSum(result_,tmp_,int32_t{3},int32_t{64},1,1,8);}}SN_AI void Softmax(){ReduceRows<true>();Brcb(tmp_,result_,uint8_t{3},{1,8});Sub(matrix_[2*P],matrix_[2*P],tmp_,SN_U64{StaticH},SN_SC<uint8_t>(StaticH),{1,1,0,3,3,1});Exp(matrix_[2*P],matrix_[2*P],StaticH*P);ReduceRows<false>();for(SN_U32 b=0;b<3;++b){Brcb(columns_[8*b],result_,uint8_t{3},{3,P});}Div(matrix_[2*P],matrix_[2*P],columns_,StaticH*P);Adds(matrix_[2*P],matrix_[2*P],eps_,StaticH*P);}SN_AI void NormalizeColumns(){Duplicate(denom_,eps_,StaticH);Add(denom_,matrix_[2*P],denom_,SN_U64{StaticH},SN_SC<uint8_t>(StaticH),{1,1,1,0,3,0});Copy(columns_,denom_,SN_U64{P},SN_SC<uint8_t>(StaticH),{1,1,3,0});Div(matrix_[2*P],matrix_[2*P],columns_,StaticH*P);}GlobalTensor<float>inputGm_,preGm_,postGm_,combGm_;LocalTensor<float>matrix_,tmp_,work_,denom_,result_,columns_;SN_U64 packedRowMask_[2];SN_U32 iters_;float eps_;};}template<SN_U32 StaticH>
__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f04_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();sinkhorn_f04::NarrowSingleP24Kernel<StaticH>op;op.Init(mixes,pre,post,comb,tiling.eps,tiling.iters);op.Process();PipeBarrier<PIPE_ALL>();}
#endif  


#ifndef SINKHORN_NORM_KERNELS_F01_TINY_SPLIT_H_
#define SINKHORN_NORM_KERNELS_F01_TINY_SPLIT_H_
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
namespace sinkhorn_f01{using namespace AscendC;using sinkhorn_norm::TilingData;template<SN_U32 StaticH=0>
class TinySplitKernel{static constexpr SN_U32 P=8;static constexpr SN_U32 kTileBytes=4*P*P +512+8*P;static constexpr SN_U32 kTmpOffset=kTileBytes;static constexpr SN_U32 kDenomOffset=kTmpOffset+8*P*4+P*4;static constexpr SN_U32 kResultOffset=kDenomOffset+P*4;static constexpr SN_U32 kPatternOffset=kResultOffset+P*4;public:
SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const TilingData&t){if constexpr(StaticH!=0){h_=StaticH;}else{h_=t.h;}eps_=t.eps;}SN_AI void Process(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb){constexpr SN_U32 effH=StaticH!=0 ? StaticH:0;const SN_U32 hVal=effH!=0 ? effH:h_;const bool gates=(GetBlockIdx()&1)==(hVal>2 ? 1:0);inputGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));matrix_=LocalTensor<float>(TPosition::VECCALC,0,kTileBytes/4);tmp_=LocalTensor<float>(TPosition::VECCALC,kTmpOffset,8*P);if(gates){if ASCEND_IS_AIV{set_mov_pad_val(0);}asc_copy_gm2ub_align(SN_RC<SN_UB*>(matrix_.GetPhyAddr()),SN_RC<__gm__ float*>(mixes),2,hVal*4,0,P -hVal,0,0);preGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));postGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));if ASCEND_IS_AIV{auto*gTmp=SN_RC<SN_UB*>(tmp_.GetPhyAddr());SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<(2*P))-1);vector_dup(gTmp +2*P,1.0f,1,1,1,8,0);SN_V;}Sync<HardEvent::MTE2_V>();GatePair(hVal);Sync<HardEvent::V_MTE3>();asc_copy_ub2gm_align(SN_RC<__gm__ float*>(pre),SN_RC<SN_UB*>(matrix_.GetPhyAddr()),hVal*4);asc_copy_ub2gm_align(SN_RC<__gm__ float*>(post),SN_RC<SN_UB*>(matrix_.GetPhyAddr())+P,hVal*4);}else{if ASCEND_IS_AIV{set_mov_pad_val(0);}asc_copy_gm2ub_align(SN_RC<SN_UB*>(matrix_.GetPhyAddr())+2*P,SN_RC<__gm__ float*>(mixes)+2*hVal,hVal,hVal*4,0,P -hVal,0,0);combGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));denom_=LocalTensor<float>(TPosition::VECCALC,kDenomOffset,P);result_=LocalTensor<float>(TPosition::VECCALC,kResultOffset,P);pattern_=LocalTensor<SN_U32>(TPosition::VECCALC,kPatternOffset,P);SN_U64 mask0=0;if constexpr(StaticH!=0){constexpr SN_U64 columns=
SN_U64{0x0101010101010101}*((SN_U64{1}<<StaticH)-1);constexpr SN_U64 rows=
StaticH==8 ? ~SN_U64{0}:(~SN_U64{0}>>(64-8*StaticH));mask0=columns&rows;}else{const SN_U64 columns=
SN_U64{0x0101010101010101}*((SN_U64{1}<<hVal)-1);const SN_U64 rows=
hVal==8 ? ~SN_U64{0}:(~SN_U64{0}>>(64-8*hVal));mask0=columns&rows;}const bool packOutput=(hVal<8)&&(hVal*hVal*sizeof(float)>32);if(packOutput){const SN_U32 rowBits=((SN_U32{1}<<hVal)-1)*0x01010101U;Duplicate(pattern_,rowBits,P);}const float scale=(StaticH==5)? 6.0f:
(hVal==5)? 6.0f:
(hVal==2)? 3.0f:
(hVal==3)? 4.0f:
(hVal==4)? 5.0f:
(hVal==6)? 7.0f:
(hVal==7)? 8.0f:
(hVal==8)? 9.0f:6.0f;const float seededEps=scale*eps_;Duplicate(result_,0.0f,P);Duplicate(denom_,seededEps,P);if ASCEND_IS_AIV{SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,mask0);SN_V;}Sync<HardEvent::MTE2_V>();RunMatrixSingleRound(hVal,mask0);if(packOutput){SN_U64 packedCount=0;GatherMask(tmp_,matrix_[2*P],pattern_,true,hVal*P,{1,1,8,0},packedCount);}Sync<HardEvent::V_MTE3>();if(packOutput){asc_copy_ub2gm_align(SN_RC<__gm__ float*>(comb),SN_RC<SN_UB*>(tmp_.GetPhyAddr()),hVal*hVal*4);}else{asc_copy_ub2gm_align(SN_RC<__gm__ float*>(comb),SN_RC<SN_UB*>(matrix_.GetPhyAddr())+2*P,hVal,hVal*4,0,0,0,0);}}}private:
template<HardEvent Event>
SN_AI void Sync(){SetFlag<Event>(EVENT_ID0);WaitFlag<Event>(EVENT_ID0);}SN_AI void GatePair(SN_U32 hVal){if ASCEND_IS_AIV{auto*gates=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto*gTmp=SN_RC<SN_UB*>(tmp_.GetPhyAddr());auto*gNum=gTmp +2*P;auto*gDenom=gTmp +4*P;vmuls(gTmp,gates,-1.0f,1,1,1,8,8);SN_V;vmins(gTmp,gTmp,80.0f,1,1,1,8,8);SN_V;vexp(gTmp,gTmp,1,1,1,8,8);SN_V;vadds(gDenom,gTmp,1.0f,1,1,1,8,8);SN_V;vdiv(gates,gNum,gDenom,1,1,1,1,8,8,8);SN_V;SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<hVal)-1);vadds(gates,gates,eps_,1,1,1,8,8);vmuls(gates+P,gates+P,2.0f,1,1,1,8,8);SN_V;ResetMask();}}SN_AI void RunMatrixSingleRound(SN_U32 hVal,SN_U64 mask0){if ASCEND_IS_AIV{auto*mat=
SN_RC<SN_UB*>(matrix_.GetPhyAddr())+2*P;auto*tmp=SN_RC<SN_UB*>(tmp_.GetPhyAddr());auto*denom=SN_RC<SN_UB*>(denom_.GetPhyAddr());auto*result=SN_RC<SN_UB*>(result_.GetPhyAddr());vcgmax(result,mat,1,1,1,8);SN_V;vbrcb(SN_RC<__ubuf__ SN_U32*>(tmp),SN_RC<__ubuf__ SN_U32*>(result),1,8,1);SN_V;vsub(mat,mat,tmp,1,1,1,1,8,8,8);SN_V;vexp(mat,mat,1,1,1,8,8);SN_V;vcgadd(result,mat,1,1,1,8);SN_V;vbrcb(SN_RC<__ubuf__ SN_U32*>(tmp),SN_RC<__ubuf__ SN_U32*>(result),1,8,1);SN_V;vdiv(tmp,mat,tmp,1,1,1,1,8,8,8);SN_V;vadds(mat,tmp,eps_,1,1,1,8,8);SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<hVal)-1);vadd(denom,tmp,denom,SN_SC<uint8_t>(hVal),1,1,1,0,1,0);SN_V;SN_VM<float,MaskMode::NORMAL>(0,mask0);vdiv(mat,mat,denom,1,1,1,0,8,8,0);SN_V;ResetMask();}}GlobalTensor<float>inputGm_,preGm_,postGm_,combGm_;LocalTensor<float>matrix_,tmp_,denom_,result_;LocalTensor<SN_U32>pattern_;SN_U32 h_;float eps_;};}template<SN_U32 StaticH=0>
__global__ __aicore__ void sinkhorn_f01_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();sinkhorn_f01::TinySplitKernel<StaticH>op;op.Init(mixes,pre,post,comb,tiling);op.Process(mixes,pre,post,comb);PipeBarrier<PIPE_ALL>();}
#endif


#ifndef SINKHORN_NORM_KERNELS_F02_TINY_SINGLE_H_
#define SINKHORN_NORM_KERNELS_F02_TINY_SINGLE_H_
#include "kernel_operator.h"
namespace sinkhorn_norm{using namespace AscendC;template<SN_U32 H,bool Tuned=false>
class F02_TinySingle{static_assert(H>=2&&H<8,"Tiny single geometry family: H in [2, 7]");static constexpr SN_U32 P=8;static constexpr SN_U32 kMatrixFloats=10*P;static constexpr SN_U32 TmpOffset=512;static constexpr SN_U32 GateTmpOffset=TmpOffset+8*P*4;static constexpr SN_U32 DenomOffset=GateTmpOffset+8*P*4;static constexpr SN_U32 ResultOffset=DenomOffset+8*P*4;static constexpr SN_U32 PatternOffset=ResultOffset+8*P*4;static constexpr SN_U32 TransposeOffset=2048;static constexpr SN_U32 IndexOffset=2304;static constexpr SN_U32 RowFactorOffset=2560;static constexpr SN_U32 ColFactorOffset=2816;static constexpr SN_U32 EpsFactorOffset=3072;static_assert(EpsFactorOffset+256<=8192,"Tiny-single UB budget");static constexpr SN_U64 kCols=
SN_U64{0x0101010101010101}*((SN_U64{1}<<H)-1);static constexpr SN_U64 kPaddingDiagonal=SN_U64{0x8040201008040201}&~kCols;static constexpr SN_U64 kRows=~SN_U64{0}>>(64-8*H);static constexpr SN_U64 kMask=kCols&kRows;static constexpr SN_U64 kRowSumCols=
SN_U64{0x0101010101010101}*((SN_U64{1}<<(H+1))-1);static constexpr SN_U64 kRowSumMask=kRowSumCols&kRows;static constexpr SN_U64 kColHEpsMask=
(SN_U64{0x0101010101010101}<<H)&kRows;static constexpr SN_U64 kGatePairMask=(SN_U64{1}<<(2*P))-1;static constexpr SN_U64 kPreGateMask=(SN_U64{1}<<H)-1;static constexpr SN_U64 kPostGateMask=((SN_U64{1}<<H)-1)<<P;public:
SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,float eps){eps_=eps;inputGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));preGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));postGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));combGm_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));matrix_=LocalTensor<float>(TPosition::VECCALC,0,kMatrixFloats);tmp_=LocalTensor<float>(TPosition::VECCALC,TmpOffset,8*P);gateTmp_=LocalTensor<float>(TPosition::VECCALC,GateTmpOffset,8*P);denom_=LocalTensor<float>(TPosition::VECCALC,DenomOffset,8*P);result_=LocalTensor<float>(TPosition::VECCALC,ResultOffset,8*P);pattern_=LocalTensor<SN_U32>(TPosition::VECCALC,PatternOffset,P);transpose_=LocalTensor<float>(TPosition::VECCALC,TransposeOffset,64);transposeIndex_=LocalTensor<SN_U32>(TPosition::VECCALC,IndexOffset,64);rowFactor_=LocalTensor<float>(TPosition::VECCALC,RowFactorOffset,64);colFactor_=LocalTensor<float>(TPosition::VECCALC,ColFactorOffset,64);epsFactor_=LocalTensor<float>(TPosition::VECCALC,EpsFactorOffset,64);}template<bool MatrixOnly=false>
SN_AI void Process(SN_U32 iters){const SN_U64 token=GetBlockIdx();const DataCopyExtParams inputCopy{SN_SC<uint16_t>(MatrixOnly ? H:H+2),H*SN_U32{sizeof(float)},0,0,0};const DataCopyPadExtParams<float>pad{true,0,SN_SC<uint8_t>(P -H),0.0f};auto denseInput=LocalTensor<float>(TPosition::VECCALC,4096,64);auto inputIndex=LocalTensor<int32_t>(TPosition::VECCALC,4352,64);if constexpr(MatrixOnly){const DataCopyExtParams denseCopy{1,H*H*SN_U32{sizeof(float)},0,0,0};const DataCopyPadExtParams<float>densePad{false,0,0,0.0f};DataCopyPad(denseInput,inputGm_[token*H*(H+2)+2*H],denseCopy,densePad);}else{DataCopyPad(matrix_,inputGm_[token*H*(H+2)],inputCopy,pad);}Duplicate(result_,0.0f,P);if constexpr(!MatrixOnly)Duplicate(gateTmp_[2*P],1.0f,2*P);if constexpr(H<P){constexpr SN_U32 rowBits=((SN_U32{1}<<H)-1)*0x01010101U;Duplicate(pattern_,rowBits,P);}const bool useFactors=H!=3&&eps_>=0x1p-40f&&eps_<=1.0f;if constexpr(MatrixOnly){if constexpr(Tuned)SeedPairs<4,H>(inputIndex.template ReinterpretCast<SN_U64>());else for(SN_U32 c=0;c<8;++c)inputIndex.SetValue(c,c<H ? c*4:0);}if(useFactors){if constexpr(Tuned)SeedPairs<32,P>(transposeIndex_.template ReinterpretCast<SN_U64>());else for(SN_U32 c=0;c<8;++c)transposeIndex_.SetValue(c,c*32);}if(MatrixOnly||useFactors){Sync<HardEvent::S_V>();SetMaskNorm();for(SN_U32 rows=1;rows<8;rows*=2){SN_VM<int32_t,MaskMode::NORMAL>(
0,(SN_U64{1}<<(rows*8))-1);if constexpr(MatrixOnly){Adds<int32_t,false>(inputIndex[rows*8],inputIndex,SN_SC<int32_t>(rows*H*4),rows*8);}if(useFactors){auto index=transposeIndex_.ReinterpretCast<int32_t>();Adds<int32_t,false>(index[rows*8],index,SN_SC<int32_t>(rows*4),rows*8);}SN_VB;}ResetMask();}Sync<HardEvent::MTE2_V>();if constexpr(MatrixOnly){Gather(matrix_[2*P],denseInput,inputIndex.ReinterpretCast<SN_U32>(),SN_U32{0},H*P);SN_VB;}RunTinySingleFused<MatrixOnly>(iters,useFactors);SN_U64 packedCount=0;GatherMask(tmp_,matrix_[2*P],pattern_,true,H*P,{1,1,8,0},packedCount);Sync<HardEvent::V_MTE3>();if constexpr(!MatrixOnly){const DataCopyExtParams gateCopy{1,H*SN_U32{sizeof(float)},0,0,0};DataCopyPad(preGm_[token*H],matrix_,gateCopy);DataCopyPad(postGm_[token*H],matrix_[P],gateCopy);}const DataCopyExtParams matrixCopy{1,H*H*SN_U32{sizeof(float)},0,0,0};DataCopyPad(combGm_[token*H*H],tmp_,matrixCopy);}private:
template<SN_U32 Stride,SN_U32 Live>
SN_AI void SeedPairs(LocalTensor<SN_U64>indices){
#pragma unroll
for(SN_U32 c=0;c<P;c+=2){const SN_U64 low=c<Live ? c*Stride:0;const SN_U64 high=c+1<Live ?(c+1)*Stride:0;indices.SetValue(c/2,low|(high<<32));}}template<HardEvent Event>
SN_AI void Sync(){SetFlag<Event>(EVENT_ID0);WaitFlag<Event>(EVENT_ID0);}template<bool MatrixOnly>
