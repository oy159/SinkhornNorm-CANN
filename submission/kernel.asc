panRepeats,1,1,1,8,8,8);pipe_barrier(PIPE_V);uint32_t col = 0;for (;col + 64 <= span;col += 64){vmul(matrix + col,matrix + col,denom + col,h,1,1,1,spanBlocks,spanBlocks,0);}if (col < span){WideRoundMask(colTailMask);vmul(matrix + col,matrix + col,denom + col,h,1,1,1,spanBlocks,spanBlocks,0);}pipe_barrier(PIPE_V);}}}class NarrowP16ShortBatchKernel {public:
__aicore__ inline void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const sinkhorn_norm::TilingData &t){t_ = t;const uint64_t core = GetBlockIdx();start_ = core * t_.tokens_per_core +
(core < t_.extra_core_count ? core : t_.extra_core_count);count_ = t_.tokens_per_core + (core < t_.extra_core_count ? 1 : 0);input_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(mixes));pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pre));post_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(post));comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(comb));rp_ = (t_.h * t_.tile_tokens + 7)/ 8 * 8;const uint32_t span = t_.tile_tokens * t_.h_pad;ones_cap_ = rp_ > 2 * span ? rp_ : 2 * span;const uint32_t tmp = 8 * rp_ > 6 * span ? 8 * rp_ : 6 * span;dense_gate_cap_ = (t_.h * t_.tile_tokens + 63)/ 64 * 64;const uint32_t matrixCap = (t_.h * t_.h * t_.tile_tokens + 63)/ 64 * 64;zero_offset_ = 2 * dense_gate_cap_ + matrixCap;input_gate_cap_ = (2 * span + 63)/ 64 * 64;const uint32_t inputMatrixCap = (t_.h * span + 63)/ 64 * 64;pipe_.InitBuffer(matrixBuffer_,16 * span * sizeof(float)+ 256);pipe_.InitBuffer(gateBuffer_,2 * t_.gate_bytes + 256);pipe_.InitBuffer(partialBuffer_,t_.input_bytes + (tmp + 2 * rp_)* sizeof(float)+ 256);pipe_.InitBuffer(onesBuffer_,ones_cap_ * sizeof(float)+ 256);pipe_.InitBuffer(denomBuffer_,span * sizeof(float)+ 256);pipe_.InitBuffer(denseOutputBuffer_,4 * zero_offset_ + 32);pipe_.InitBuffer(inputIndexBuffer_,4 * (input_gate_cap_ + inputMatrixCap));dense_output_ = denseOutputBuffer_.Get<float>();matrix_ = matrixBuffer_.Get<float>();gates_ = gateBuffer_.Get<float>();partial_ = partialBuffer_.Get<float>();tmp_ = partial_[t_.input_bytes / sizeof(float)];ones_ = onesBuffer_.Get<float>();denom_ = denomBuffer_.Get<float>();input_index_ = inputIndexBuffer_.Get<int32_t>();constants_ready_ = false;input_indexed_valid_ = 0;}__aicore__ inline void Process(){for (uint64_t offset = 0;offset < count_;offset += t_.tile_tokens){const uint64_t first = start_ + offset;const uint64_t left = count_ - offset;valid_ = left < t_.tile_tokens ? static_cast<uint32_t>(left): t_.tile_tokens;rows_ = t_.h * valid_;span_ = t_.h_pad * valid_;CopyInAndBuildMaps(first);GatesAndRowMax();WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);const uint32_t gStride = (valid_ - 1)* t_.h_pad / 8;const DataCopyExtParams gOut{1,4 * t_.h,gStride,0,0};for (uint32_t token = 0;token < valid_;++token){const uint64_t base = first + token;DataCopyPad(pre_[base * t_.h],gates_[token * t_.h_pad],gOut);DataCopyPad(post_[base * t_.h],gates_[span_ + token * t_.h_pad],gOut);}SetMaskNorm();RunNarrowShortBatchCompleteRounds(
