namespace sinkhorn_norm {namespace f08 {using namespace AscendC;static __aicore__ __attribute__((always_inline))inline void WideRoundMask(uint64_t mask){SetVectorMask<float,MaskMode::NORMAL>(uint64_t{0},mask);}template <int Op>
