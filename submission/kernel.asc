template <HardEvent event>
__aicore__ inline void Sync(){SetFlag<event>(EVENT_ID0);WaitFlag<event>(EVENT_ID0);}__aicore__ inline void SetDenseInputPaddingAnchor(LocalTensor<int32_t> tensor,uint32_t rows){const uint32_t live = t_.h % 8;if (live == 0)return;const int32_t anchorByteOffset = static_cast<int32_t>(4 * zero_offset_);uint64_t mask[2] = {uint64_t{0xff}^ ((uint64_t{1}<< live)- 1),0};for (uint32_t first = 0;first < rows;first += 248){const uint32_t n = rows - first < 248 ? rows - first : 248;Duplicate(tensor[first * t_.h_pad + t_.h_pad - 8],anchorByteOffset,mask,static_cast<uint8_t>(n),uint16_t{1},static_cast<uint8_t>(t_.h_pad / 8));}PipeBarrier<PIPE_V>();}__aicore__ inline void BuildDenseInputMaps(){auto token = partial_.template ReinterpretCast<int32_t>();CreateVecIndex(input_index_,int32_t{0},span_);PipeBarrier<PIPE_V>();ShiftRight(token,input_index_,int32_t{4},span_);PipeBarrier<PIPE_V>();Muls(token,token,static_cast<int32_t>(t_.input_width - 16),span_);PipeBarrier<PIPE_V>();Add(input_index_,input_index_,token,span_);PipeBarrier<PIPE_V>();Muls(input_index_,input_index_,int32_t{4},span_);PipeBarrier<PIPE_V>();for (uint32_t planes = 1;planes < t_.h + 2;planes *= 2){const uint32_t n =
t_.h + 2 - planes < planes ? t_.h + 2 - planes : planes;Adds(input_index_[planes * span_],input_index_,static_cast<int32_t>(4 * planes * t_.h),n * span_);PipeBarrier<PIPE_V>();}SetDenseInputPaddingAnchor(input_index_[2 * span_],rows_);}__aicore__ inline void CopyInAndBuildMaps(uint64_t first){const DataCopyExtParams packed{1,4 * valid_ * t_.input_width,0,0,0};const DataCopyPadExtParams<float> noPad{false,0,0,0.0f};DataCopyPad(dense_output_,input_[first * t_.input_width],packed,noPad);if (!constants_ready_){Duplicate(denom_,0.0f,rp_ + 64);Duplicate(ones_,1.0f,ones_cap_ + 64);Duplicate(dense_output_[zero_offset_],0.0f,8);PipeBarrier<PIPE_V>();constants_ready_ = true;}if (t_.h < 16){Duplicate(matrix_[rows_ * t_.h_pad],0.0f,(16 - t_.h)* span_ + 64);PipeBarrier<PIPE_V>();}if (input_indexed_valid_ != valid_){BuildDenseInputMaps();input_indexed_valid_ = valid_;}Sync<HardEvent::MTE2_V>();auto index = input_index_.template ReinterpretCast<uint32_t>();Gather(gates_,dense_output_,index,uint32_t{0},2 * span_);Gather(matrix_,dense_output_,index[2 * span_],uint32_t{0},t_.h * span_);PipeBarrier<PIPE_V>();}__aicore__ inline void GatesAndRowMax(){Muls(tmp_,gates_,-1.0f,2 * span_);for (uint32_t first = 0;first < rows_;first += 255){const int32_t count =
