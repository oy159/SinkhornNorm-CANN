__aicore__ inline void RunBatchedGateRole(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,uint32_t tokens,float eps){GlobalTensor<float> input,preOut,postOut;input.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(mixes));preOut.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pre));postOut.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(post));TPipe pipe;TBuf<TPosition::VECCALC> arena;pipe.InitBuffer(arena,32768);auto dense = arena.Get<float>();auto gates = dense[4096];auto work = dense[5120];auto ones = dense[6144];auto index = dense[7168].template ReinterpretCast<int32_t>();auto row = dense[7680].template ReinterpretCast<int32_t>();const uint32_t n = H * tokens,p = (n + 7)/ 8 * 8;const DataCopyExtParams in{1,4 * H * (H + 2)* tokens,0,0,0};const DataCopyPadExtParams<float> noPad{false,0,0,0.0f};DataCopyPad(dense,input,in,noPad);CreateVecIndex(index,int32_t{0},n);Duplicate(gates,0.0f,2 * p);Duplicate(ones,1.0f,2 * p);PipeBarrier<PIPE_V>();Muls(row,index,int32_t{((1 << 20)+ H - 1)/ H},n);PipeBarrier<PIPE_V>();ShiftRight(row,row,int32_t{20},n);PipeBarrier<PIPE_V>();Muls(row,row,int32_t{H * (H + 1)},n);PipeBarrier<PIPE_V>();Add(index,index,row,n);PipeBarrier<PIPE_V>();Muls(index,index,int32_t{4},n);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);PipeBarrier<PIPE_V>();Gather(gates,dense,index.ReinterpretCast<uint32_t>(),uint32_t{0},n);Gather(gates[p],dense,index.ReinterpretCast<uint32_t>(),uint32_t{4 * H},n);PipeBarrier<PIPE_V>();Muls(work,gates,-1.0f,2 * p);PipeBarrier<PIPE_V>();Mins(work,work,80.0f,2 * p);PipeBarrier<PIPE_V>();Exp(work,work,2 * p);PipeBarrier<PIPE_V>();Adds(work,work,1.0f,2 * p);PipeBarrier<PIPE_V>();Div(gates,ones,work,2 * p);PipeBarrier<PIPE_V>();Adds(gates,gates,eps,n);Muls(gates[p],gates[p],2.0f,n);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);const DataCopyExtParams out{1,4 * n,0,0,0};DataCopyPad(preOut,gates,out);DataCopyPad(postOut,gates[p],out);}}template <uint32_t H>
