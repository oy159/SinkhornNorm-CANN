SN_AI void Init(GM_ADDR mixes,GM_ADDR comb,SN_U32 tokens,float eps){tokens_=tokens;eps_=eps;input_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));output_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));matrix_=LocalTensor<float>(TPosition::VECCALC,0,128);row_=LocalTensor<float>(TPosition::VECCALC,512,32);col_=LocalTensor<float>(TPosition::VECCALC,640,32);}SN_AI void Process(SN_U32 iters){const SN_U32 first=8*GetBlockIdx(),left=tokens_-first;const SN_U32 valid=left<8 ? left:8;auto dense=LocalTensor<float>(TPosition::VECCALC,4096,128);auto in=LocalTensor<int32_t>(TPosition::VECCALC,4608,128);auto out=LocalTensor<int32_t>(TPosition::VECCALC,5120,128);auto ts=LocalTensor<int32_t>(TPosition::VECCALC,768,8);const DataCopyExtParams copy{1,60*valid,0,0,0};const DataCopyPadExtParams<float>pad{false,0,0,0.0f};DataCopyPad(dense,input_[15*first],copy,pad);Duplicate(in[72],int32_t{0},56);
#pragma unroll
for(SN_U32 t=0;t<8;++t)ts.SetValue(t,t<valid ? 60*t:0);auto outputPairs=out.ReinterpretCast<SN_U64>();
#pragma unroll
for(SN_U32 q=0;q<72;q+=2){const SN_U64 lo=4*(8*(q%9)+q/9);const SN_U64 hi=4*(8*((q+1)%9)+(q+1)/9);outputPairs.SetValue(q/2,lo|(hi<<32));}Sync<HardEvent::S_V>();SetMaskNorm();SN_VM<int32_t,MaskMode::NORMAL>(0,0xff);
