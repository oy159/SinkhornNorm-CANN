// f06_narrow_p16_paired_rows.h
#ifndef SINKHORN_NORM_KERNELS_F06_NARROW_P16_PAIRED_ROWS_H_
#define SINKHORN_NORM_KERNELS_F06_NARROW_P16_PAIRED_ROWS_H_
#include "kernel_operator.h"
namespace sinkhorn_norm {namespace f06 {using namespace AscendC;static __aicore__ __attribute__((always_inline))inline void WideRoundMask(uint64_t mask){SetVectorMask<float,MaskMode::NORMAL>(uint64_t{0},mask);}template <int Op>
static __aicore__ __attribute__((always_inline))inline void WideRoundSpan(
__ubuf__ float *dst,__ubuf__ float *a,__ubuf__ float *b,uint32_t count,float scalar = 0.0f){uint32_t first = 0;while (count - first >= 64){const uint32_t left = (count - first)/ 64;const uint8_t repeats = left < 255 ? left : 255;if constexpr (Op == 0)vadd(dst + first,a + first,b + first,repeats,1,1,1,8,8,8);if constexpr (Op == 1)vadds(dst + first,a + first,scalar,repeats,1,1,8,8);if constexpr (Op == 2)vdiv(dst + first,a + first,b + first,repeats,1,1,1,8,8,8);if constexpr (Op == 3)vcopy(reinterpret_cast<__ubuf__ uint32_t *>(dst + first),reinterpret_cast<__ubuf__ uint32_t *>(a + first),repeats,1,1,8,8);if constexpr (Op == 4)vmul(dst + first,a + first,b + first,repeats,1,1,1,8,8,8);first += 64 * repeats;}if (first < count){WideRoundMask((uint64_t{1}<< (count - first))- 1);if constexpr (Op == 0)vadd(dst + first,a + first,b + first,1,1,1,1,8,8,8);if constexpr (Op == 1)vadds(dst + first,a + first,scalar,1,1,1,8,8);if constexpr (Op == 2)vdiv(dst + first,a + first,b + first,1,1,1,1,8,8,8);if constexpr (Op == 3)vcopy(reinterpret_cast<__ubuf__ uint32_t *>(dst + first),reinterpret_cast<__ubuf__ uint32_t *>(a + first),1,1,1,8,8);if constexpr (Op == 4)vmul(dst + first,a + first,b + first,1,1,1,1,8,8,8);WideRoundMask(~uint64_t{0});}}static __aicore__ __attribute__((always_inline))inline void WideRoundFullRepeatsAdd(
