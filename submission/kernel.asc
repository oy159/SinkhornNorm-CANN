Fp mat,Fp part,Fp tmp,Fp res,SN_U32 h,SN_U32 valid){if ASCEND_IS_AIV{const SN_U32 rows=h*valid,blocks=h/8,plane=rows*8;const uint8_t nPlane=SN_SC<uint8_t>(plane/64);WideMask(~SN_U64{0});WideRows<true>(mat,part,res,rows,blocks);vbrcb(SN_RC<Up>(tmp),SN_RC<Up>(res),1,8,rows/8);SN_V;auto mBlock=mat;for(SN_U32 block=0;block<blocks;++block){vsub(mBlock,mBlock,tmp,nPlane,1,1,1,8,8,8);mBlock+=plane;}SN_V;WideSpan<6>(mat,mat,mat,rows*h);SN_V;}}F12_FN void DampedResidual(Fp out,Fp hist,Fp tmp,Fp normalized,SN_U32 rp,SN_U32 rows,SN_U32 iteration){if ASCEND_IS_AIV{auto h0=hist+((iteration-1)%2)*rp;auto h1=hist+((iteration-2)%2)*rp;const uint8_t n=(rows+63)/64;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,rows);vsub(tmp,h0,h1,n,1,1,1,8,8,8);SN_V;vmuls(out,tmp,0.8f,n,1,1,8,8);SN_V;vadd(out,out,h0,n,1,1,1,8,8,8);SN_V;vadds(normalized,out,1.0f,n,1,1,8,8);SN_V;SetMaskNorm();WideMask(~SN_U64{0});}}F12_FN void PackedContinuation(Fp row,Fp col,Fp ones,Fp scratch,Fp recent,Fp previous,Fp oldest,SN_U32 rows,float eps){if ASCEND_IS_AIV{const SN_U32 span=2*rows;const uint8_t n=(span+63)/64;auto product=scratch;auto delta=product+span;auto prior=delta+span;auto norm=prior+span;auto cross=norm+span;auto rate=cross+span;auto step=rate+span;auto next=step+span;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,span);vsub(delta,recent,previous,n,1,1,1,8,8,8);vsub(prior,previous,oldest,n,1,1,1,8,8,8);vmul(product,previous,previous,n,1,1,1,8,8,8);vmul(step,previous,recent,n,1,1,1,8,8,8);SN_V;vmul(norm,prior,prior,n,1,1,1,8,8,8);vmul(cross,delta,prior,n,1,1,1,8,8,8);vector_dup(prior,0.0f,n,1,1,8,0);SN_V;vaxpy(norm,product,0.125f,n,1,1,8,8);vaxpy(cross,step,0.125f,n,1,1,8,8);SN_V;vadds(norm,norm,0x1p-28f,n,1,1,8,8);vadds(cross,cross,SN_SC<float>(0.8f*0x1p-28f),n,1,1,8,8);SN_V;vdiv(rate,cross,norm,n,1,1,1,8,8,8);vadds(product,recent,SN_SC<float>(1.0f+eps),n,1,1,8,8);SN_V;vmax(rate,rate,prior,n,1,1,1,8,8,8);SN_V;vmins(rate,rate,1.0f,n,1,1,8,8);SN_V;vmul(step,delta,rate,n,1,1,1,8,8,8);SN_V;vadd(product,product,step,n,1,1,1,8,8,8);vmul(next,step,rate,n,1,1,1,8,8,8);SN_V;vadd(prior,product,next,n,1,1,1,8,8,8);vmul(step,next,rate,n,1,1,1,8,8,8);SN_V;vadd(norm,prior,step,n,1,1,1,8,8,8);vmul(product,product,prior,n,1,1,1,8,8,8);SN_V;vmul(product,product,norm,n,1,1,1,8,8,8);SN_V;const uint8_t nRows=(rows+63)/64;SN_VM<float,MaskMode::COUNTER>(0,rows);vdiv(row,ones,product,nRows,1,1,1,8,8,8);vdiv(col,ones,product+rows,nRows,1,1,1,8,8,8);SN_V;SetMaskNorm();WideMask(~SN_U64{0});}}F12_FN void ApplyColumnFactors(Fp mat,Fp denom,SN_U32 h,SN_U32 valid){if ASCEND_IS_AIV{for(SN_U32 slab=0;slab<(h/8)*valid;++slab)
