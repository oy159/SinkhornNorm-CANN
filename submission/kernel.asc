:t_.tile_tokens;CopyIn(start_+offset,valid);for(SN_U32 token=0;token<valid;++token){const SN_U32 tokenOffset=token*(t_.h+2)*t_.h_pad;if constexpr(MergeGates){ComputeGatePairStable(matrix_[tokenOffset],tmp_,t_.h,t_.h_pad,t_.eps);}else{ComputeGateStable(matrix_[tokenOffset],tmp_,work_,denom_,t_.h,t_.eps,true);ComputeGateStable(matrix_[tokenOffset+t_.h_pad],tmp_,work_,denom_,t_.h,t_.eps,false);}const SN_U32 matrixOffset=tokenOffset+2*t_.h_pad;Softmax(matrixOffset);NormalizeColumns(matrixOffset);for(SN_U32 iter=1;iter<t_.iters;++iter){NormalizeRows(matrixOffset);NormalizeColumns(matrixOffset);}}CopyOut(start_+offset,valid);}}private:
