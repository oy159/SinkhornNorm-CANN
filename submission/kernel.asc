__aicore__ inline void ReduceRows(uint32_t base){const uint64_t width = t_.h < 64 ? t_.h : 64;const auto rows = static_cast<uint8_t>(t_.h);const auto stride = static_cast<uint8_t>(t_.h_pad / 8);if constexpr (maximum){WholeReduceMax(result_,matrix_[base],width,rows,1,1,stride,ReduceOrder::ORDER_ONLY_VALUE);}else {WholeReduceSum(result_,matrix_[base],width,rows,1,1,stride);}if (t_.h > 64){if constexpr (maximum){WholeReduceMax(work_,matrix_[base + 64],uint64_t{t_.h - 64},rows,1,1,stride,ReduceOrder::ORDER_ONLY_VALUE);}else {WholeReduceSum(work_,matrix_[base + 64],uint64_t{t_.h - 64},rows,1,1,stride);}PipeBarrier<PIPE_V>();if constexpr (maximum){Max(result_,result_,work_,t_.h);}else {Add(result_,result_,work_,t_.h);}}PipeBarrier<PIPE_V>();}__aicore__ inline void BroadcastRows(){Brcb(tmp_,result_,static_cast<uint8_t>(t_.h_pad / 8),{1,8});PipeBarrier<PIPE_V>();}__aicore__ inline void NormalizeFromRowSums(uint32_t base){if constexpr (ReuseInverse){Div(result_,ones_,result_,t_.h);PipeBarrier<PIPE_V>();}BroadcastRows();const auto stride = static_cast<uint8_t>(t_.h_pad / 8);for (uint32_t col = 0;col < t_.h;col += 64){const uint64_t width = t_.h - col < 64 ? t_.h - col : 64;if constexpr (ReuseInverse){Mul(matrix_[base + col],matrix_[base + col],tmp_,width,static_cast<uint8_t>(t_.h),{1,1,0,stride,stride,1});}else {Div(matrix_[base + col],matrix_[base + col],tmp_,width,static_cast<uint8_t>(t_.h),{1,1,0,stride,stride,1});}}PipeBarrier<PIPE_V>();}__aicore__ inline void Softmax(uint32_t base){ReduceRows<true>(base);BroadcastRows();const auto stride = static_cast<uint8_t>(t_.h_pad / 8);for (uint32_t col = 0;col < t_.h;col += 64){const uint64_t width = t_.h - col < 64 ? t_.h - col : 64;Sub(matrix_[base + col],matrix_[base + col],tmp_,width,static_cast<uint8_t>(t_.h),{1,1,0,stride,stride,1});}PipeBarrier<PIPE_V>();Exp(matrix_[base],matrix_[base],t_.h * t_.h_pad);PipeBarrier<PIPE_V>();ReduceRows<false>(base);NormalizeFromRowSums(base);Adds(matrix_[base],matrix_[base],t_.eps,t_.h * t_.h