SN_UB*m,SN_UB*d,SN_U32 h,SN_U32 p,SN_U32 valid,float eps,SN_U32 iters){if ASCEND_IS_AIV{SN_V;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(SN_U64{0},SN_U64{valid});for(SN_U32 iter=0;iter<iters;++iter){if(iter!=0){for(SN_U32 r=0;r<h;++r){vadd(d+r*p,m+r*h*p,m+(r*h+1)*p,1,1,1,1,8,8,8);}SN_V;for(SN_U32 c=2;c<h;++c){for(SN_U32 r=0;r<h;++r){vadd(d+r*p,d+r*p,m+(r*h+c)*p,1,1,1,1,8,8,8);}SN_V;}for(SN_U32 r=0;r<h;++r){vadds(d+r*p,d+r*p,eps,1,1,1,8,8);}SN_V;for(SN_U32 r=0;r<h;++r){for(SN_U32 c=0;c<h;++c){auto cell=m+(r*h+c)*p;vdiv(cell,cell,d+r*p,1,1,1,1,8,8,8);}}SN_V;}for(SN_U32 c=0;c<h;++c){vadds(d+c*p,m+c*p,eps,1,1,1,8,8);}SN_V;for(SN_U32 r=1;r<h;++r){for(SN_U32 c=0;c<h;++c){vadd(d+c*p,m+(r*h+c)*p,d+c*p,1,1,1,1,8,8,8);}SN_V;}for(SN_U32 r=0;r<h;++r){for(SN_U32 c=0;c<h;++c){auto cell=m+(r*h+c)*p;vdiv(cell,cell,d+c*p,1,1,1,1,8,8,8);}}SN_V;}SetMaskNorm();ResetMask();}}class F03_TinyTokenPlanes{public:
SN_AI void Init(GM_ADDR input,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData t,SN_U32 capacity){t_=t;cap_=capacity;h_=t.h;width_=h_*(h_+2);const SN_U64 block=GetBlockIdx();count_=t.tokens_per_core +(block<t.extra_core_count ? 1:0);start_=block*t.tokens_per_core +
(block<t.extra_core_count ? block:t.extra_core_count);input_.SetGlobalBuffer(SN_RC<__gm__ float*>(input));pre_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));post_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));comb_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));pipe_.InitBuffer(denseBuffer_,4*width_*cap_);pipe_.InitBuffer(planeBuffer_,4*width_*cap_);pipe_.InitBuffer(indexBuffer_,4*(1+h_+h_*h_)*cap_);pipe_.InitBuffer(scratchBuffer_,4*2*cap_);dense_=denseBuffer_.Get<float>();planes_=planeBuffer_.Get<float>();inIndex_=indexBuffer_.Get<int32_t>();gateIndex_=inIndex_[cap_];matrixIndex_=gateIndex_[h_*cap_];a_=scratchBuffer_.Get<float>();b_=a_[cap_];c_=dense_[cap_];SeedOutputIndices(gateIndex_,h_);SeedOutputIndices(matrixIndex_,h_*h_);Sync<HardEvent::S_V>();indices_ready_=false;}SN_AI void Process(){for(SN_U64 offset=0;offset<count_;offset+=cap_){const SN_U32 valid=count_-offset<cap_
? SN_SC<SN_U32>(count_-offset)
:cap_;const SN_U64 first=start_+offset;const DataCopyExtParams copy{1,4*width_*valid,0,0,0};const DataCopyPadExtParams<float>padding{false,0,0,0.0f};DataCopyPad(dense_,input_[first*width_],copy,padding);if(!indices_ready_){ExpandOutputIndices(gateIndex_,h_);ExpandOutputIndices(matrixIndex_,h_*h_);CreateVecIndex(inIndex_,int32_t{0},cap_);SN_VB;Muls(inIndex_,inIndex_,SN_SC<int32_t>(4*width_),cap_);SN_VB;indices_ready_=true;}Sync<HardEvent::MTE2_V>();for(SN_U32 element=0;element<width_;++element){Gather(planes_[element*cap_],dense_,inIndex_.ReinterpretCast<SN_U32>(),4*element,valid);}SN_VB;Gates(valid);if(h_==2){RunCompactPlaneSoftmaxAndRoundsH2(
SN_RC<SN_UB*>(planes_.GetPhyAddr())+
2*h_*cap_,SN_RC<SN_UB*>(dense_.GetPhyAddr()),cap_,valid,t_.eps,t_.iters);}else{Softmax(valid);RunCompactPlaneRounds(
SN_RC<SN_UB*>(planes_.GetPhyAddr())+
2*h_*cap_,SN_RC<SN_UB*>(dense_.GetPhyAddr()),h_,cap_,valid,t_.eps,t_.iters);}Gather(dense_,planes_,gateIndex_.ReinterpretCast<SN_U32>(),SN_U32{0},h_*valid);Gather(dense_[h_*cap_],planes_[h_*cap_],gateIndex_.ReinterpretCast<SN_U32>(),SN_U32{0},h_*valid);SN_VB;SetFlag<HardEvent::V_MTE3>(EVENT_ID1);Gather(dense_[2*h_*cap_],planes_[2*h_*cap_],matrixIndex_.ReinterpretCast<SN_U32>(),SN_U32{0},h_*h_*valid);WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);const DataCopyExtParams gateCopy{1,4*h_*valid,0,0,0};DataCopyPad(pre_[first*h_],dense_,gateCopy);DataCopyPad(post_[first*h_],dense_[h_*cap_],gateCopy);Sync<HardEvent::V_MTE3>();const DataCopyExtParams matrixCopy{1,4*h_*h_*valid,0,0,0};DataCopyPad(comb_[first*h_*h_],dense_[2*h_*cap_],matrixCopy);if(offset+cap_<count_){Sync<HardEvent::MTE3_MTE2>();}}PipeBarrier<PIPE_ALL>();}private:
template<HardEvent Event>
SN_AI void Sync(){SetFlag<Event>(EVENT_ID0);WaitFlag<Event>(EVENT_ID0);}SN_AI void SeedOutputIndices(LocalTensor<int32_t>index,SN_U32 elements){for(SN_U32 token=0;token<8;++token){for(SN_U32 element=0;element<elements;++element){index.SetValue(token*elements+element,SN_SC<int32_t>(4*(element*cap_+token)));}}}SN_AI void ExpandOutputIndices(LocalTensor<int32_t>index,SN_U32 elements){for(SN_U32 token=8;token<cap_;token+=8){Adds(index[token*elements],index,SN_SC<int32_t>(4*token),8*elements);}SN_VB;}SN_AI LocalTensor<float>Cell(SN_U32 row,SN_U32 col){return planes_[(2*h_+row*h_+col)*cap_];}SN_AI void Gates(SN_U32 valid){const bool full=valid==cap_;const SN_U32 n=full ? 2*h_*cap_:valid;auto a=full ? dense_:a_;auto b=full ? dense_[n]:b_;for(SN_U32 g=0;g<(full ? 1:2*h_);++g){auto x=planes_[g*cap_];Duplicate(b,1.0f,n);Muls(a,x,-1.0f,n);SN_VB;Mins(a,a,80.0f,n);SN_VB;Exp(a,a,n);SN_VB;Adds(a,a,1.0f,n);SN_VB;Div(x,b,a,n);SN_VB;if(full){Adds(x,x,t_.eps,h_*cap_);Muls(x[h_*cap_],x[h_*cap_],2.0f,h_*cap_);}else if(g<h_){Adds(x,x,t_.eps,n);}else{Muls(x,x,2.0f,n);}SN_VB;}}SN_AI void Softmax(SN_U32 valid){for(SN_U32 row=0;row<h_;++row){Max(a_,Cell(row,0),Cell(row,1),valid);SN_VB;for(SN_U32 col=2;col<h_;++col){Max(a_,a_,Cell(row,col),valid);SN_VB;}for(SN_U32 col=0;col<h_;++col){Sub(Cell(row,col),Cell(row,col),a_,valid);}SN_VB;for(SN_U32 col=0;col<h_;++col){Exp(Cell(row,col),Cell(row,col),valid);}SN_VB;RowSum(row,valid);for(SN_U32 col=0;col<h_;++col){Div(Cell(row,col),Cell(row,col),b_,valid);}SN_VB;for(SN_U32 col=0;col<h_;++col){Adds(Cell(row,col),Cell(row,col),t_.eps,valid);}SN_VB;}}SN_AI void RowSum(SN_U32 row,SN_U32 valid){Add(b_,Cell(row,0),Cell(row,1),valid);SN_VB;for(SN_U32 col=2;col<h_;++col){Add(b_,b_,Cell(row,col),valid);SN_VB;}}TPipe pipe_;TBuf<TPosition::VECCALC>denseBuffer_,planeBuffer_,indexBuffer_,scratchBuffer_;GlobalTensor<float>input_,pre_,post_,comb_;LocalTensor<float>dense_,planes_,a_,b_,c_;LocalTensor<int32_t>inIndex_,gateIndex_,matrixIndex_;sinkhorn_norm::TilingData t_;SN_U64 start_,count_;SN_U32 h_,width_,cap_;bool indices_ready_;};}}template<int=0>
