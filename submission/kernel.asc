__ubuf__ float *m,__ubuf__ float *d,uint32_t h,uint32_t p,uint32_t valid,float eps,uint32_t iters){if ASCEND_IS_AIV {pipe_barrier(PIPE_V);SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(uint64_t{0},uint64_t{valid});for (uint32_t iter = 0;iter < iters;++iter){if (iter != 0){for (uint32_t r = 0;r < h;++r){vadd(d + r * p,m + r * h * p,m + (r * h + 1)* p,1,1,1,1,8,8,8);}pipe_barrier(PIPE_V);for (uint32_t c = 2;c < h;++c){for (uint32_t r = 0;r < h;++r){vadd(d + r * p,d + r * p,m + (r * h + c)* p,1,1,1,1,8,8,8);}pipe_barrier(PIPE_V);}for (uint32_t r = 0;r < h;++r){vadds(d + r * p,d + r * p,eps,1,1,1,8,8);}pipe_barrier(PIPE_V);for (uint32_t r = 0;r < h;++r){for (uint32_t c = 0;c < h;++c){auto cell = m + (r * h + c)* p;vdiv(cell,cell,d + r * p,1,1,1,1,8,8,8);}}pipe_barrier(PIPE_V);}for (uint32_t c = 0;c < h;++c){vadds(d + c * p,m + c * p,eps,1,1,1,8,8);}pipe_barrier(PIPE_V);for (uint32_t r = 1;r < h;++r){for (uint32_t c = 0;c < h;++c){vadd(d + c * p,m + (r * h + c)* p,d + c * p,1,1,1,1,8,8,8);}pipe_barrier(PIPE_V);}for (uint32_t r = 0;r < h;++r){for (uint32_t c = 0;c < h;++c){auto cell = m + (r * h + c)* p;vdiv(cell,cell,d + c * p,1,1,1,1,8,8,8);}}pipe_barrier(PIPE_V);}SetMaskNorm();ResetMask();}}class F03_TinyTokenPlanes {public:
__aicore__ inline void Init(GM_ADDR input,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData t,uint32_t capacity){t_ = t;cap_ = capacity;h_ = t.h;width_ = h_ * (h_ + 2);const uint64_t block = GetBlockIdx();count_ = t.tokens_per_core + (block < t.extra_core_count ? 1 : 0);start_ = block * t.tokens_per_core +
(block < t.extra_core_count ? block : t.extra_core_count);input_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(input));pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pre));post_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(post));comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(comb));pipe_.InitBuffer(denseBuffer_,4 * width_ * cap_);pipe_.InitBuffer(planeBuffer_,4 * width_ * cap_);pipe_.InitBuffer(indexBuffer_,4 * (1 + h_ + h_ * h_)* cap_);pipe_.InitBuffer(scratchBuffer_,4 * 2 * cap_);dense_ = denseBuffer_.Get<float>();planes_ = planeBuffer_.Get<float>();inIndex_ = indexBuffer_.Get<int32_t>();gateIndex_ = inIndex_[cap_];matrixIndex_ = gateIndex_[h_ * cap_];a_ = scratchBuffer_.Get<float>();b_ = a_[cap_];c_ = dense_[cap_];SeedOutputIndices(gateIndex_,h_);SeedOutputIndices(matrixIndex_,h_ * h_);Sync<HardEvent::S_V>();indices_ready_ = false;}__aicore__ inline void Process(){for (uint64_t offset = 0;offset < count_;offset += cap_){const uint32_t valid = count_ - offset < cap_
? static_cast<uint32_t>(count_ - offset)
: cap_;const uint64_t first = start_ + offset;const DataCopyExtParams copy{1,4 * width_ * valid,0,0,0};const DataCopyPadExtParams<float> padding{false,0,0,0.0f};DataCopyPad(dense_,input_[first * width_],copy,padding);if (!indices_ready_){ExpandOutputIndices(gateIndex_,h_);ExpandOutputIndices(matrixIndex_,h_ * h_);CreateVecIndex(inIndex_,int32_t{0},cap_);PipeBarrier<PIPE_V>();Muls(inIndex_,inIndex_,static_cast<int32_t>(4 * width_),cap_);PipeBarrier<PIPE_V>();indices_ready_ = true;}Sync<HardEvent::MTE2_V>();for (uint32_t element = 0;element < width_;++element){Gather(planes_[element * cap_],dense_,inIndex_.ReinterpretCast<uint32_t>(),4 * element,valid);}PipeBarrier<PIPE_V>();Gates(valid);if (h_ == 2){RunCompactPlaneSoftmaxAndRoundsH2(
