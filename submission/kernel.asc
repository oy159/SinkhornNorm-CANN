.Get<float>();gates_=gateBuffer_.Get<float>();partial_=partialBuffer_.Get<float>();tmp_=partial_;ones_=onesBuffer_.Get<float>();denom_=denomBuffer_.Get<float>();if(count_>0){const DataCopyExtParams packed{SN_SC<uint16_t>(TileLength(0,count_)),4*InputWidth(),0,0,0};const DataCopyPadExtParams<float>noPad{false,0,0,0.0f};DataCopyPad(dense_input_,input_[start_*InputWidth()],packed,noPad);SetFlag<HardEvent::MTE2_V>(EVENT_ID2);}Duplicate(denom_,0.0f,rp);Duplicate(ones_,1.0f,ones);SN_VB;valid_=TileLength(0,count_);rows_=Height()*valid_;span_=GateSpan();BuildDenseInputMaps();if(!compact_gates_)BuildDenseOutputMap<false>(output_index_,Height()*t_.tile_tokens);gate_output_map_ready_=true;}SN_AI void Process(){const DataCopyPadExtParams<float>noPad{false,0,0,0.0f};for(SN_U64 offset=0,tile=0;offset<count_;offset+=valid_,++tile){const SN_U64 first=start_+offset;const SN_U64 left=count_-offset;valid_=TileLength(tile,left);rows_=Height()*valid_;span_=GateSpan();matrix_=matrixBuffer_.Get<float>()[((2*Height())%8)*((valid_+15)/16*16)];WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);auto index=input_index_.template ReinterpretCast<SN_U32>();SN_U32 liveGates=span_;if constexpr(UseFactors){liveGates=Height()*valid_;if(liveGates!=span_){Duplicate(gates_,0.0f,2*span_);SN_VB;}}Gather(gates_,dense_input_,index,SN_U32{0},liveGates);Gather(gates_[span_],dense_input_,index[input_map_span_],SN_U32{0},liveGates);UnpackMatrixBlocks();SN_VB;if(offset+valid_<count_){const SN_U64 next_first=first+valid_;const SN_U64 next_left=count_-(offset+valid_);const SN_U32 next_valid=
