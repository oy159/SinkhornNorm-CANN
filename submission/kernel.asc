Fp dst,Fp a,Fp b,SN_U32 count,float scalar=0.0f){if ASCEND_IS_AIV{SetMaskCount();for(SN_U32 offset=0;offset<count;){const SN_U32 left=count-offset;const SN_U32 current=left<255*64?left:255*64;const uint8_t repeats=SN_SC<uint8_t>((current+63)/64);SN_VM<float,MaskMode::COUNTER>(0,current);if constexpr(Op==0)
vadd(dst+offset,a+offset,b+offset,repeats,1,1,1,8,8,8);else if constexpr(Op==1)
vadds(dst+offset,a+offset,scalar,repeats,1,1,8,8);else if constexpr(Op==2)
vdiv(dst+offset,a+offset,b+offset,repeats,1,1,1,8,8,8);else if constexpr(Op==3)
vmul(dst+offset,a+offset,b+offset,repeats,1,1,1,8,8,8);else if constexpr(Op==4)
vmax(dst+offset,a+offset,b+offset,repeats,1,1,1,8,8,8);else if constexpr(Op==5)
vsub(dst+offset,a+offset,b+offset,repeats,1,1,1,8,8,8);else if constexpr(Op==6)
