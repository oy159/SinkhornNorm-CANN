SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const TilingData&t){t_=t;t_.h=128;t_.h_pad=128;t_.input_width=128*(128+2);const SN_U64 core=GetBlockIdx();start_=core*t_.tokens_per_core +
(core<t_.extra_core_count ? core:t_.extra_core_count);count_=t_.tokens_per_core +(core<t_.extra_core_count ? 1:0);input_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));pre_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));post_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));comb_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));const SN_U32 rows=t_.h*t_.tile_tokens;const SN_U32 span=t_.h_pad*t_.tile_tokens;pipe_.InitBuffer(matrixBuffer_,t_.matrix_bytes);pipe_.InitBuffer(gateBuffer_,2*t_.gate_bytes);pipe_.InitBuffer(partialBuffer_,t_.input_bytes);pipe_.InitBuffer(tmpBuffer_,17*rows*sizeof(float));pipe_.InitBuffer(denomBuffer_,span*sizeof(float));pipe_.InitBuffer(onesBuffer_,(4*span+64)*sizeof(float));matrix_=matrixBuffer_.Get<float>();gates_=gateBuffer_.Get<float>();partial_=partialBuffer_.Get<float>()[64];tmp_=tmpBuffer_.Get<float>();result_=tmp_[16*rows];ones_=onesBuffer_.Get<float>();denom_=denomBuffer_.Get<float>();Duplicate(result_,0.0f,rows);Duplicate(ones_,1.0f,4*span+64);const SN_U64 one=(SN_U64{1}<<16)-1;sumMask_[0]=0;sumMask_[1]=0;for(SN_U32 row=0;row<4;++row)sumMask_[0]|=one<<(16*row);SN_VB;}SN_AI void Process(){for(SN_U64 offset=0;offset<count_;offset+=valid_){const SN_U64 left=count_-offset;valid_=left<t_.tile_tokens ? SN_SC<SN_U32>(left)
:t_.tile_tokens;rows_=t_.h*valid_;span_=t_.h_pad*valid_;if(offset>0){Sync<HardEvent::V_MTE2>();}SkewCopyIn(start_+offset);Sync<HardEvent::MTE2_V>();Gates();Sync<HardEvent::V_MTE3>();CopyGatesOut(start_+offset);Duplicate(ones_,1.0f,span_);Softmax(start_+offset);Sync<HardEvent::MTE3_V>();SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(64);SN_VB;auto matrix=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto partial=SN_RC<SN_UB*>(partial_.GetPhyAddr());auto tmp=SN_RC<SN_UB*>(tmp_.GetPhyAddr());auto ones=SN_RC<SN_UB*>(ones_.GetPhyAddr());auto result=ones+64;auto denom=SN_RC<SN_UB*>(denom_.GetPhyAddr());auto history=SN_RC<SN_UB*>(gates_.GetPhyAddr());if(valid_==2)
RunFirstColumnsAndRotatingRounds2(matrix,partial,tmp,result,ones,denom,t_.eps,t_.iters-1,history);else
RunFirstColumnsAndRotatingRounds1(matrix,partial,tmp,result,ones,denom,t_.eps,t_.iters-1,history);SN_VB;ResetMask();if(t_.iters>=15){if(valid_==2)FinalRoundAndOutput<2>(start_+offset);else FinalRoundAndOutput<1>(start_+offset);}else{Sync<HardEvent::V_MTE3>();CopyRotatedOut(start_+offset);}Sync<HardEvent::MTE3_V>();Sync<HardEvent::MTE3_MTE2>();}}private:
template<HardEvent event>
SN_AI void Sync(){const auto id=pipe_.FetchEventID(event);SetFlag<event>(id);WaitFlag<event>(id);}SN_AI LocalTensor<float>QuarterTensor(SN_U32 node,SN_U32 logical){if(node==4){auto allocation=partialBuffer_.Get<float>();return allocation[logical==0 ? 64:0];}return matrix_[node*kRotateNodeFloats+
(((node&1)^(logical==0 ? 0U:1U))? 64:0)];}template<SN_U32 Valid,SN_U32 Logical>
SN_AI void ScaleAndOutputQuarter(SN_U32 node,SN_UB*source,SN_UB*tmp,SN_UB*denom,SN_U64 first){auto destination=QuarterTensor(node,Logical);RotateScaleColumnQuarter<Valid,Logical>(
SN_RC<SN_UB*>(destination.GetPhyAddr()),source,tmp,denom);Sync<HardEvent::V_MTE3>();const DataCopyExtParams q{32,4*128,(Valid-1)*128/8,0,0};for(SN_U32 token=0;token<Valid;++token)
DataCopyPad(comb_[(first+token)*128*128+Logical*32*128],destination[token*128],q);}template<SN_U32 Valid>
SN_AI void FinalRoundAndOutput(SN_U64 first){SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(64);SN_VB;const auto phase=(2*(t_.iters-2)-8)%5;const auto state=RotateStateAt(phase);const SN_U32 n0=state.node[0],n1=state.node[1];const SN_U32 n2=state.node[2],n3=state.node[3],n4=state.node[4];auto matrix=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto partial=SN_RC<SN_UB*>(partial_.GetPhyAddr());auto tmp=SN_RC<SN_UB*>(tmp_.GetPhyAddr());auto ones=SN_RC<SN_UB*>(ones_.GetPhyAddr());auto result=ones+64;auto denom=SN_RC<SN_UB*>(denom_.GetPhyAddr());auto history=SN_RC<SN_UB*>(gates_.GetPhyAddr());auto a=RotateView(matrix,partial,n0,0);auto b=RotateView(matrix,partial,n1,1);auto c=RotateView(matrix,partial,n2,2);auto d=RotateView(matrix,partial,n3,3);auto empty=RotateView(matrix,partial,n4,0);auto flippedA=RotateView(matrix,partial,n0,1);auto flippedC=RotateView(matrix,partial,n2,0);auto flippedEmpty=RotateView(matrix,partial,n4,1);RotateCommonRoundImpl<Valid,ColumnScaling::Defer>(a,b,c,d,empty,flippedA,flippedC,flippedEmpty,tmp,result,ones,denom,t_.eps,history);ScaleAndOutputQuarter<Valid,0>(n2,empty,tmp,denom,first);ScaleAndOutputQuarter<Valid,3>(n4,flippedA,tmp,denom,first);ScaleAndOutputQuarter<Valid,1>(n0,d,tmp,denom,first);ScaleAndOutputQuarter<Valid,2>(n3,b,tmp,denom,first);SN_VB;ResetMask();}template<bool CopyGates=true>
SN_AI void SkewCopyIn(SN_U64 first){const SN_U32 prefix=32;const SN_U32 stride=(valid_-1)*t_.h_pad/8;const DataCopyPadExtParams<float>pad{true,0,0,0.0f};const DataCopyExtParams lo{SN_SC<uint16_t>(prefix),4*t_.h,0,stride,0};const DataCopyExtParams hi{SN_SC<uint16_t>(t_.h-prefix),4*t_.h,0,stride,0};for(SN_U32 token=0;token<valid_;++token){const SN_U64 base=(first+token)*t_.input_width;if constexpr(CopyGates){const DataCopyExtParams gates{2,4*t_.h,0,stride,0};DataCopyPad(gates_[token*t_.h_pad],input_[base],gates,pad);}DataCopyPad(matrix_[token*t_.h_pad],input_[base +2*t_.h],lo,pad);DataCopyPad(matrix_[prefix*span_+64+token*t_.h_pad],input_[base +(2+prefix)*t_.h],hi,pad);}}SN_AI void Gates(){const SN_U32 n=2*span_;auto numerator=tmp_[n];auto denominator=tmp_[2*n];Duplicate(numerator,1.0f,n);Muls(tmp_,gates_,-1.0f,n);Mins(tmp_,tmp_,80.0f,n);Exp(tmp_,tmp_,n);Adds(denominator,tmp_,1.0f,n);Div(gates_,numerator,denominator,n);Adds(gates_,gates_,t_.eps,span_);Muls(gates_[span_],gates_[span_],2.0f,span_);}template<bool Maximum>
SN_AI void SkewCounterParts(){const SN_U32 prefix=32*valid_;SetMaskCount();for(SN_U32 segment=0;segment<2;++segment){const SN_U32 first=segment==0 ? 0:prefix;const SN_U32 count=segment==0 ? prefix:rows_-prefix;auto m=matrix_[first*t_.h_pad+(segment==0 ? 0:64)];SN_VM<float,MaskMode::COUNTER>(0,count*t_.h);if(Maximum){BlockReduceMax<float,false>(partial_[first*16],m,1,MASK_PLACEHOLDER,1,1,8);}else{BlockReduceSum<float,false>(partial_[first*16],m,1,MASK_PLACEHOLDER,1,1,8);}}}SN_AI void BlockWideRowMax(){SkewCounterParts<true>();SN_VB;SetMaskNorm();ResetMask();const SN_U32 groups=rows_/8;Max(tmp_,partial_,partial_[8],SN_U64{64},SN_SC<uint8_t>(groups),{1,2,2,8,16,16});SN_VB;BlockReduceMax(result_,tmp_,SN_SC<int32_t>(groups),int32_t{64},1,1,8);SN_VB;}SN_AI void BroadcastRows(){const auto repeats=SN_SC<uint8_t>(rows_/8);Brcb(partial_,result_,repeats,{1,16});Brcb(partial_[64],result_,repeats,{1,16});}template<bool Subtract>
SN_AI void SkewApplyRows(){SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(64);SN_VB;auto matrix=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto coefficients=
SN_RC<SN_UB*>(partial_.GetPhyAddr());if(valid_==2){if constexpr(Subtract)
ApplyCompleteSkewRowsSub2(matrix,coefficients);else
ApplyCompleteSkewRowsMul2(matrix,coefficients);}else{if constexpr(Subtract)
ApplyCompleteSkewRowsSub1(matrix,coefficients);else
ApplyCompleteSkewRowsMul1(matrix,coefficients);}SN_VB;SetMaskNorm();ResetMask();}SN_AI void RowSums(){SkewCounterParts<false>();SetMaskNorm();ResetMask();const SN_U32 groups=rows_/4;BlockReduceSum(tmp_,partial_,SN_SC<int32_t>(groups),sumMask_,1,1,8);PairReduceSum(result_,tmp_,SN_SC<int32_t>(rows_/32),int32_t{64},1,1,8);}SN_AI bool DirectRowSumsAreSafe(){SN_VB;const auto groups=SN_SC<uint8_t>(rows_/64);constexpr auto values=ReduceOrder::ORDER_ONLY_VALUE;WholeReduceSum(partial_,result_,SN_U64{64},groups,1,1,8);WholeReduceMin(partial_[8],result_,SN_U64{64},groups,1,1,8,values);SN_VB;WholeReduceSum(tmp_,partial_,SN_SC<SN_U64>(groups),1,1,1,8);WholeReduceMin(tmp_[8],partial_[8],SN_SC<SN_U64>(groups),1,1,1,8,values);Sync<HardEvent::V_S>();return tmp_.GetValue(8)>=0x1p-80f&&tmp_.GetValue(0)<=0x1p88f;}SN_AI void ExponentiateAndSum(SN_U32 first,SN_U32 rest){Exp(matrix_,matrix_,first);Exp(matrix_[first+64],matrix_[first+64],rest);RowSums();}SN_AI void Softmax(SN_U64 firstToken){const SN_U32 first=32*valid_*t_.h_pad;const SN_U32 rest=rows_*t_.h_pad-first;ExponentiateAndSum(first,rest);if(!DirectRowSumsAreSafe()){Sync<HardEvent::V_MTE2>();SkewCopyIn<false>(firstToken);Sync<HardEvent::MTE2_V>();BlockWideRowMax();BroadcastRows();SkewApplyRows<true>();ExponentiateAndSum(first,rest);}Div(result_,ones_,result_,rows_);BroadcastRows();SkewApplyRows<false>();Adds(matrix_,matrix_,t_.eps,first);Adds(matrix_[first+64],matrix_[first+64],t_.eps,rest);}SN_AI void CopyGatesOut(SN_U64 first){const DataCopyExtParams g{1,4*t_.h,0,0,0};for(SN_U32 token=0;token<valid_;++token){const SN_U64 n=first+token;DataCopyPad(pre_[n*t_.h],gates_[token*t_.h_pad],g);DataCopyPad(post_[n*t_.h],gates_[span_+token*t_.h_pad],g);}}SN_AI void CopyRotatedOut(SN_U64 first){RotateState state;const SN_U32 physicalPasses=2*(t_.iters-1)-(t_.iters>=15 ? 8:0);switch(physicalPasses%5){case 0:
