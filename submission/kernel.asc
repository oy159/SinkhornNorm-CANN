namespace sinkhorn_norm{namespace{constexpr std::SN_U64 kAlignmentBytes=32;constexpr std::SN_U64 kFloatBytes=4;constexpr std::SN_U64 kReservedBytes=8192;constexpr std::SN_U64 kScratchVectors=12;constexpr std::SN_U64 Align32(std::SN_U64 bytes){return(bytes+kAlignmentBytes-1)/kAlignmentBytes*kAlignmentBytes;}struct BufferSizes{std::SN_U64 input;std::SN_U64 matrix;std::SN_U64 gate;std::SN_U64 scratch;std::SN_U64 reserved=kReservedBytes;std::SN_U64 Total()const{return input+matrix+2*gate +scratch+reserved;}bool FitsMetadata()const{constexpr auto limit=std::numeric_limits<std::SN_U32>::max();return input<=limit&&matrix<=limit&&gate<=limit&&
