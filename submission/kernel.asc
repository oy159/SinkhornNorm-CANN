SN_AI void Init(GM_ADDR input,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,TilingData t,SN_U32 capacity){t_=t;cap_=capacity;const SN_U64 block=GetBlockIdx();count_=t.tokens_per_core +(block<t.extra_core_count);start_=block*t.tokens_per_core +
