__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f05_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);sinkhorn_norm::f05::NarrowP16ShortBatchKernel op;op.Init(mixes,pre,post,comb,tiling);op.Process();}
