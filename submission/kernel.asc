// tiling_key.cpp
namespace sinkhorn_norm {TilingKey SelectTilingKey(std::uint32_t blocks,const TilingData &tiling,bool /*bank_columns*/){
if (tiling.core_count == 0 || blocks == 0 || tiling.h < 2 || tiling.h > 128 ||
tiling.h_pad != (tiling.h + 7)/ 8 * 8 ||
tiling.input_width != tiling.h * (tiling.h + 2)|| tiling.iters < 1 ||
tiling.iters > 32 || tiling.tile_tokens == 0){return 0;}if (blocks == 2 * tiling.core_count && UsesCompactSplitOutputs(tiling)){return KeyOf(KernelFamily::F01_TinySplit,tiling.h == 5 ? 5 : 0);}if (blocks == tiling.core_count + 1 && UsesTinyThreeRow(tiling)){return KeyOf(KernelFamily::F02_TinySingle,3);}if (blocks == tiling.core_count + 1 && tiling.token_count <= 64 && UsesTinySingle(tiling)){return KeyOf(KernelFamily::F02_TinySingle,tiling.h);}if (blocks != tiling.core_count){return 0;}if (UsesTinySingle(tiling)){return KeyOf(KernelFamily::F02_TinySingle,tiling.h);}if (UsesCompactTokenPlanes(tiling)){return KeyOf(KernelFamily::F03_TinyTokenPlanes,0);}if (tiling.h >= 17 && tiling.h <= 24 && tiling.h_pad == 24 &&
UsesPackedPaddedRows(tiling)){return KeyOf(KernelFamily::F04_NarrowSingle,tiling.h);}if (UsesDenseMediumIo(tiling)){return KeyOf(KernelFamily::F09_MediumDenseIo,0);}if (UsesWideBlockedRounds(tiling)){return KeyOf(KernelFamily::F12_WideBlocked,0);}if (UsesRotatingQuarters(tiling)){return KeyOf(KernelFamily::F14_WideRotating128,0);}if (UsesCompactFive(tiling)){return KeyOf(KernelFamily::F13_WideQuarterStream,0);}if (UsesAlignedMedium(tiling)){return KeyOf(KernelFamily::F11_MediumAligned64,0);}if (tiling.h >= 17 && tiling.h <= 24 && tiling.iters >= 3 &&
UsesGroupedNarrowRound(blocks,tiling)){return KeyOf(KernelFamily::F08_NarrowP24Recurrent,1);}if (UsesCompactMediumWorkspace(tiling)){return KeyOf(KernelFamily::F10_MediumCompact,0);}if (UsesShortNarrowBatch(tiling)){return KeyOf(KernelFamily::F05_NarrowP16ShortBatch,0);}if (tiling.h <= 16 && tiling.iters >= 4 &&
UsesGroupedNarrowRound(blocks,tiling)){return KeyOf(KernelFamily::F06_NarrowP16PairedRows,0);}if (UsesDenseNarrowIo(tiling)){return KeyOf(KernelFamily::F07_NarrowP16DenseIo,0);}if (2 * tiling.h_pad <= 64){return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralMergeGates);}if (tiling.h > 64 && tiling.eps >= 0.0f){if (HasNormalInverseEpsilon(tiling.h,tiling.eps)){return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralWideTreeInverse);}return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralWideTree);}return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralBase);}}

// primitives.h
#ifndef SINKHORN_NORM_COMMON_PRIMITIVES_H_
#define SINKHORN_NORM_COMMON_PRIMITIVES_H_
#include "kernel_operator.h"
#define SINKHORN_AIV_NOINLINE static __aicore__ __attribute__((noinline))
#define SINKHORN_AIV_NOINLINE_ALIGNED static __aicore__ __attribute__((noinline))
namespace sinkhorn_norm {namespace primitives {using namespace AscendC;template <HardEvent event>
__aicore__ __attribute__((always_inline))inline void SyncEvent(TPipe &pipe){const auto id = pipe.FetchEventID(event);SetFlag<event>(id);WaitFlag<event>(id);}__aicore__ __attribute__((always_inline))inline void ComputeGateStable(
const LocalTensor<float> &gate,const LocalTensor<float> &tmp,const LocalTensor<float> &work,const LocalTensor<float> &denom,uint32_t h,float eps,bool is_pre){Abs(tmp,gate,h);Mins(work,gate,0.0f,h);PipeBarrier<PIPE_V>();Muls(tmp,tmp,-1.0f,h);Exp(work,work,h);PipeBarrier<PIPE_V>();Exp(tmp,tmp,h);PipeBarrier<PIPE_V>();Adds(denom,tmp,1.0f,h);PipeBarrier<PIPE_V>();Div(gate,work,denom,h);PipeBarrier<PIPE_V>();if (is_pre){Adds(gate,gate,eps,h);}else {Muls(gate,gate,2.0f,h);}PipeBarrier<PIPE_V>();}__aicore__ __attribute__((always_inline))inline void ComputeGatePairStable(
const LocalTensor<float> &gates,const LocalTensor<float> &tmp,uint32_t h,uint32_t h_pad,float eps){const uint32_t count = 2 * h_pad;auto abs_exp = tmp;auto numerator = tmp[count];auto denominator = tmp[2 * count];Abs(abs_exp,gates,count);Mins(numerator,gates,0.0f,count);PipeBarrier<PIPE_V>();Muls(abs_exp,abs_exp,-1.0f,count);Exp(numerator,numerator,count);PipeBarrier<PIPE_V>();Exp(abs_exp,abs_exp,count);PipeBarrier<PIPE_V>();Adds(denominator,abs_exp,1.0f,count);PipeBarrier<PIPE_V>();Div(gates,numerator,denominator,count);PipeBarrier<PIPE_V>();Adds(gates,gates,eps,h);Muls(gates[h_pad],gates[h_pad],2.0f,h);PipeBarrier<PIPE_V>();}}}
#endif  

// f09_medium_dense_io.h
#ifndef SINKHORN_NORM_KERNELS_F09_MEDIUM_DENSE_IO_H_
#define SINKHORN_NORM_KERNELS_F09_MEDIUM_DENSE_IO_H_
#include "kernel_operator.h"
namespace sinkhorn_f09 {using namespace AscendC;using sinkhorn_norm::TilingData;__aicore__ __attribute__((always_inline))inline void RunMediumCompleteRounds(
