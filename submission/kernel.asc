class GeneralFallbackKernel{public:
SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const TilingData&tiling){t_=tiling;const SN_U64 core=GetBlockIdx();start_=core*t_.tokens_per_core +
