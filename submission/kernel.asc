SN_AI void ReduceRows(SN_U32 base){const SN_U64 width=t_.h<64 ? t_.h:64;const auto rows=SN_SC<uint8_t>(t_.h);const auto stride=SN_SC<uint8_t>(t_.h_pad/8);if constexpr(maximum){WholeReduceMax(result_,matrix_[base],width,rows,1,1,stride,ReduceOrder::ORDER_ONLY_VALUE);}else{WholeReduceSum(result_,matrix_[base],width,rows,1,1,stride);}if(t_.h>64){if constexpr(maximum){WholeReduceMax(work_,matrix_[base +64],SN_U64{t_.h-64},rows,1,1,stride,ReduceOrder::ORDER_ONLY_VALUE);}else{WholeReduceSum(work_,matrix_[base +64],SN_U64{t_.h-64},rows,1,1,stride);}SN_VB;if constexpr(maximum){Max(result_,result_,work_,t_.h);}else{Add(result_,result_,work_,t_.h);}}SN_VB;}SN_AI void BroadcastRows(){Brcb(tmp_,result_,SN_SC<uint8_t>(t_.h_pad/8),{1,8});SN_VB;}SN_AI void NormalizeFromRowSums(SN_U32 base){if constexpr(ReuseInverse){Div(result_,ones_,result_,t_.h);SN_VB;}BroadcastRows();const auto stride=SN_SC<uint8_t>(t_.h_pad/8);for(SN_U32 col=0;col<t_.h;col+=64){const SN_U64 width=t_.h-col<64 ? t_.h-col:64;if constexpr(ReuseInverse){Mul(matrix_[base +col],matrix_[base +col],tmp_,width,SN_SC<uint8_t>(t_.h),{1,1,0,stride,stride,1});}else{Div(matrix_[base +col],matrix_[base +col],tmp_,width,SN_SC<uint8_t>(t_.h),{1,1,0,stride,stride,1});}}SN_VB;}SN_AI void Softmax(SN_U32 base){ReduceRows<true>(base);BroadcastRows();const auto stride=SN_SC<uint8_t>(t_.h_pad/8);for(SN_U32 col=0;col<t_.h;col+=64){const SN_U64 width=t_.h-col<64 ? t_.h-col:64;Sub(matrix_[base +col],matrix_[base +col],tmp_,width,SN_SC<uint8_t>(t_.h),{1,1,0,stride,stride,1});}SN_VB;Exp(matrix_[base],matrix_[base],t_.h*t_.h_pad);SN_VB;ReduceRows<false>(base);NormalizeFromRowSums(base);Adds(matrix_[base],matrix_[base],t_.eps,t_.h*t_.h_pad);SN_VB;}SN_AI void NormalizeRows(SN_U32 base){ReduceRows<false>(base);Adds(result_,result_,t_.eps,t_.h);SN_VB;NormalizeFromRowSums(base);}SN_AI void NormalizeColumns(SN_U32 base){const auto stride=SN_SC<uint8_t>(t_.h_pad/8);if constexpr(TreeColumns){const SN_U32 pairs=t_.h/2;SN_U32 rows=t_.h-pairs;Add(colu