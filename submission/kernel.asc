namespace sinkhorn_norm{template<SN_U32 Steps=4>
static SN_INL void ForecastDenominatorProduct(
SN_UB*row,SN_UB*col,SN_UB*scratch,SN_UB*next,SN_UB*ones,SN_UB*recent,SN_UB*older,SN_U32 rows,float eps){static_assert(Steps==4||Steps==6);using namespace AscendC;if ASCEND_IS_AIV{const SN_U32 span=2*rows;const uint8_t repeats=(span+63)/64;auto product=scratch;auto norm=product+span;auto cross=norm+span;auto rate=cross+span;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,span);vmul(norm,older,older,repeats,1,1,1,8,8,8);vmul(cross,older,recent,repeats,1,1,1,8,8,8);vector_dup(product,0.0f,repeats,1,1,8,0);SN_V;vadds(norm,norm,0x1p-28f,repeats,1,1,8,8);vadds(cross,cross,SN_SC<float>(0.8f*0x1p-28f),repeats,1,1,8,8);SN_V;vdiv(rate,cross,norm,repeats,1,1,1,8,8,8);SN_V;vmax(rate,rate,product,repeats,1,1,1,8,8,8);SN_V;vmins(rate,rate,1.0f,repeats,1,1,8,8);SN_V;vmul(cross,recent,rate,repeats,1,1,1,8,8,8);SN_V;const float center=1.0f+eps;vadds(product,cross,SN_SC<float>(center),repeats,1,1,8,8);vmul(next,cross,rate,repeats,1,1,1,8,8,8);SN_V;vadds(norm,next,SN_SC<float>(center),repeats,1,1,8,8);vmul(cross,next,rate,repeats,1,1,1,8,8,8);SN_V;vmul(product,product,norm,repeats,1,1,1,8,8,8);vmul(next,cross,rate,repeats,1,1,1,8,8,8);SN_V;auto extra=scratch+4*span;if constexpr(Steps==6)
vmul(extra,next,rate,repeats,1,1,1,8,8,8);vadds(cross,cross,SN_SC<float>(center),repeats,1,1,8,8);vadds(norm,next,SN_SC<float>(center),repeats,1,1,8,8);SN_V;vmul(cross,cross,norm,repeats,1,1,1,8,8,8);if constexpr(Steps==6)
vmul(next,extra,rate,repeats,1,1,1,8,8,8);SN_V;vmul(product,product,cross,repeats,1,1,1,8,8,8);if constexpr(Steps==6){vadds(extra,extra,SN_SC<float>(center),repeats,1,1,8,8);vadds(next,next,SN_SC<float>(center),repeats,1,1,8,8);SN_V;vmul(norm,extra,next,repeats,1,1,1,8,8,8);SN_V;vmul(product,product,norm,repeats,1,1,1,8,8,8);}SN_V;const uint8_t rowRepeats=(rows+63)/64;SN_VM<float,MaskMode::COUNTER>(0,rows);vdiv(row,ones,product,rowRepeats,1,1,1,8,8,8);vdiv(col,ones,product+rows,rowRepeats,1,1,1,8,8,8);SN_V;SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(SN_U64{0},~SN_U64{0});}}}
#endif


