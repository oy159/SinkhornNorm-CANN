max_core_tokens,platform.ub_bytes/(5*4*q*h_pad));for(auto candidate=bound;candidate>=1;--candidate){const auto x=MakeCompactFiveLayout(h,h_pad,candidate);BufferSizes five{x.input,4*x.slot,x.gate,x.scratch};if(five.Total()<=platform.ub_bytes&&five.FitsMetadata()&&
4*x.quarter_rows*8<=9*h*candidate&&
x.quarter_rows/8<=255){use_interleaved=true;selected_tile=candidate;selected_sizes=five;break;}}}else if(h>=17&&h<=24&&problem.iters>=3&&
IsEstablishedInterleavedWorkload(h,problem.iters,tokens_per_core,problem.eps)){use_interleaved=true;selected_tile=lower;selected_sizes=sizes;}else if(compact_medium){use_interleaved=true;selected_tile=lower;selected_sizes=GetInterleavedBufferSizes(lower,h,h_pad,true);}else if(IsDenseNarrowIoWorkload(h,h_pad,problem.iters,tokens_per_core,lower,problem.eps)){const auto f07_limit=std::min(max_core_tokens,std::SN_U64{64});for(auto candidate=f07_limit;candidate>=lower;--candidate){if(candidate%16!=0)continue;if(!IsDenseNarrowIoWorkload(h,h_pad,problem.iters,tokens_per_core,candidate,problem.eps))continue;const BufferSizes candidate_sizes{DenseNarrowInputBytes(h,candidate),DenseNarrowMatrixBytes(h,candidate),4*16*candidate,DenseNarrowScratchBytes(h,candidate)};if(candidate_sizes.Total()<=platform.ub_bytes&&
DenseNarrowActualUbBytes(h,candidate)<=platform.ub_bytes&&
candidate_sizes.FitsMetadata()){use_interleaved=true;selected_tile=candidate;selected_sizes=candidate_sizes;break;}}}else if(h<=16&&problem.iters>=4){use_interleaved=true;selected_tile=lower;selected_sizes=sizes;const auto tile=std::min<std::SN_U64>(64,(max_core_tokens+15)/16*16);if(IsLongNarrowPlaneWorkload(h,h_pad,problem.iters,tokens_per_core,tile,problem.eps)){const BufferSizes planes{DenseNarrowInputBytes(h,tile),DenseNarrowMatrixBytes(h,tile),4*16*tile,DenseNarrowScratchBytes(h,tile)};if(planes.Total()<=platform.ub_bytes&&planes.FitsMetadata()){selected_tile=tile;selected_sizes=planes;}}}}if(!use_interleaved&&
IsShortNarrowBatchWorkload(h,h_pad,problem.iters,tokens_per_core,extra_core_count,problem.eps)){const auto batch_sizes=
GetInterleavedBufferSizes(max_core_tokens,h,h_pad);if(batch_sizes.Total()<=platform.ub_bytes&&
batch_sizes.FitsMetadata()){use_interleaved=true;selected_tile=max_core_tokens;selected_sizes=batch_sizes;}}if(!use_interleaved){std::SN_U64 lower=1;std::SN_U64 upper=max_core_tokens;while(lower<upper){const auto candidate=lower+(upper-lower+1)/2;const auto sizes=GetGeneralBufferSizes(candidate,h,h_pad,input_width,narrow_single_p24);if(sizes.Total()<=platform.ub_bytes&&sizes.FitsMetadata()){lower=candidate;}else{upper=candidate -1;}}auto sizes=
GetGeneralBufferSizes(lower,h,h_pad,input_width,narrow_single_p24);if(narrow_single_p24&&lower==1){auto padded_sizes=sizes;padded_sizes.matrix+=PackedPaddedRowPaddingBytes(h,h_pad);if(padded_sizes.Total()<=platform.ub_bytes&&
padded_sizes.FitsMetadata()){sizes=padded_sizes;}}selected_tile=lower;selected_sizes=sizes;}tiling.token_count=token_count;tiling.tokens_per_core=tokens_per_core;tiling.extra_core_count=SN_SC<std::SN_U32>(extra_core_count);tiling.core_count=SN_SC<std::SN_U32>(core_count);tiling.h=SN_SC<std::SN_U32>(h);tiling.h_pad=SN_SC<std::SN_U32>(h_pad);tiling.input_width=SN_SC<std::SN_U32>(input_width);tiling.iters=SN_SC<std::SN_U32>(problem.iters);tiling.tile_tokens=SN_SC<std::SN_U32>(selected_tile);tiling.input_bytes=SN_SC<std::SN_U32>(selected_sizes.input);tiling.matrix_bytes=SN_SC<std::SN_U32>(selected_sizes.matrix);tiling.gate_bytes=SN_SC<std::SN_U32>(selected_sizes.gate);tiling.scratch_bytes=SN_SC<std::SN_U32>(selected_sizes.scratch);tiling.eps=problem.eps;output_shapes.pre[0]=problem.shape[0];output_shapes.pre[1]=problem.shape[1];output_shapes.pre[2]=problem.h;output_shapes.post[0]=problem.shape[0];output_shapes.post[1]=problem.shape[1];output_shapes.post[2]=problem.h;output_shapes.comb[0]=problem.shape[0];output_shapes.comb[1]=problem.shape[1];output_shapes.comb[2]=problem.h;output_shapes.comb[3]=problem.h;return true;}bool MakeLaunchPlan(const Problem&problem,const PlatformResources&platform,LaunchPlan&plan,OutputShapes&output_shapes,std::string&error){plan={};bool bank_columns=false;if(!MakeTiling(problem,platform,plan.data,output_shapes,error,&bank_columns)){return false;}plan.blocks=plan.data.core_count;if(UsesCompactSplitOutputs(plan.data)&&
plan.data.token_count<=platform.aiv_cores/2){plan.blocks=2*plan.data.core_count;}else if(UsesTinySingle(plan.data)&&plan.data.h==3&&
plan.data.token_count<=64&&platform.aiv_cores>=2&&
platform.ub_bytes>=40960){auto&t=plan.data;t.core_count=SN_SC<SN_U32>((t.token_count+7)/8);t.tokens_per_core=8;t.extra_core_count=0;t.tile_tokens=8;t.input_bytes=512;t.matrix_bytes=512;t.gate_bytes=64;t.scratch_bytes=16384;plan.blocks=t.core_count+1;}else if(UsesTinySingle(plan.data)&&plan.data.token_count<=64&&
plan.data.core_count<platform.aiv_cores&&platform.ub_bytes>=40960){plan.blocks=plan.data.core_count+1;}plan.key=SelectTilingKey(plan.blocks,plan.data,bank_columns);if(plan.key==0){plan={};error="no compiled tiling key for launch metadata";return false;}if(FamilyOf(plan.key)==KernelFamily::F03_TinyTokenPlanes){auto&t=plan.data;const SN_U64 h=t.h,width=t.input_width;const SN_U64 lanes=3*h*h+5*h+4;const SN_U64 usable=platform.ub_bytes>kReservedBytes
? platform.ub_bytes-kReservedBytes
:0;const SN_U64 owner=
SN_U64{t.tokens_per_core}+(t.extra_core_count!=0);const SN_U64 limit=std::min({usable/(4*lanes)/64*64,(255/(h*h))*64,(owner+63)/64*64});if(limit>t.tile_tokens){t.tile_tokens=SN_SC<SN_U32>(std::min(limit,owner));t.input_bytes=SN_SC<SN_U32>(4*width*limit);t.matrix_bytes=t.input_bytes;t.gate_bytes=0;t.scratch_bytes=SN_SC<SN_U32>(4*(h*h+h+4)*limit);}const SN_U64 current=CompactPlaneCapacity(t);const SN_U64 live_lanes=3*h*h+5*h+3;const SN_U64 physical_limit=
std::min(usable/(4*live_lanes)/64*64,(255/(h*h))*64);const SN_U64 largest=
physical_limit>current
? current+(physical_limit-current)/128*128
:current;const SN_U64 best_batches=(owner+largest-1)/largest;const SN_U64 required=(owner+best_batches-1)/best_batches;const SN_U64 expanded=
required>current ? current+(required-current+127)/128*128
:current;bool improves=
expanded>current&&
(owner+expanded-1)/expanded<(owner+current-1)/current;for(SN_U64 kind=0;improves&&kind<(t.extra_core_count!=0 ? 2ULL:1ULL);++kind){const SN_U64 count=t.tokens_per_core +kind;improves=(count+expanded-1)/expanded<=
(count+current-1)/current;}if(improves){t.tile_tokens=SN_SC<SN_U32>(std::min(expanded,owner));t.input_bytes=SN_SC<SN_U32>(4*width*expanded);t.matrix_bytes=t.input_bytes;t.gate_bytes=0;t.scratch_bytes=SN_SC<SN_U32>(4*(h*h+h+3)*expanded);}}return true;}}


namespace sinkhorn_norm{TilingKey SelectTilingKey(std::SN_U32 blocks,const TilingData&tiling,bool /*bank_columns*/){
if(tiling.core_count==0||blocks==0||tiling.h<2||tiling.h>128||
tiling.h_pad!=(tiling.h+7)/8*8||
tiling.input_width!=tiling.h*(tiling.h+2)||tiling.iters<1||
tiling.iters>32||tiling.tile_tokens==0){return 0;}if(blocks==2*tiling.core_count&&UsesCompactSplitOutputs(tiling)){return KeyOf(KernelFamily::F01_TinySplit,tiling.h==5 ? 5:0);}if(blocks==tiling.core_count+1&&UsesTinyThreeRow(tiling)){return KeyOf(KernelFamily::F02_TinySingle,3);}if(blocks==tiling.core_count+1&&tiling.token_count<=64&&UsesTinySingle(tiling)){return KeyOf(KernelFamily::F02_TinySingle,tiling.h);}if(blocks!=tiling.core_count){return 0;}if(UsesTinySingle(tiling)){return KeyOf(KernelFamily::F02_TinySingle,tiling.h);}if(UsesCompactTokenPlanes(tiling)){return KeyOf(KernelFamily::F03_TinyTokenPlanes,0);}if(tiling.h>=17&&tiling.h<=24&&tiling.h_pad==24&&
UsesPackedPaddedRows(tiling)){return KeyOf(KernelFamily::F04_NarrowSingle,tiling.h);}if(UsesDenseMediumIo(tiling)){return KeyOf(KernelFamily::F09_MediumDenseIo,0);}if(UsesWideBlockedRounds(tiling)){return KeyOf(KernelFamily::F12_WideBlocked,0);}if(UsesRotatingQuarters(tiling)){return KeyOf(KernelFamily::F14_WideRotating128,0);}if(UsesCompactFive(tiling)){return KeyOf(KernelFamily::F13_WideQuarterStream,0);}if(UsesAlignedMedium(tiling)){return KeyOf(KernelFamily::F11_MediumAligned64,0);}if(tiling.h>=17&&tiling.h<=24&&tiling.iters>=3&&
UsesGroupedNarrowRound(blocks,tiling)){return KeyOf(KernelFamily::F08_NarrowP24Recurrent,1);}if(UsesCompactMediumWorkspace(tiling)){return KeyOf(KernelFamily::F10_MediumCompact,0);}if(UsesShortNarrowBatch(tiling)){return KeyOf(KernelFamily::F05_NarrowP16ShortBatch,0);}if(UsesLongNarrowPlanes(tiling)){const bool useFactors=
tiling.iters>=12&&tiling.eps>=0x1p-24f&&tiling.eps<=0x1p-8f;return KeyOf(KernelFamily::F07_NarrowP16DenseIo,useFactors ? kNarrowDenseFactorVariant:0);}if(tiling.h<=16&&tiling.iters>=4&&
UsesGroupedNarrowRound(blocks,tiling)){return KeyOf(KernelFamily::F06_NarrowP16PairedRows,0);}if(UsesDenseNarrowIo(tiling)){return KeyOf(KernelFamily::F07_NarrowP16DenseIo,4*tiling.h+tiling.iters);}if(2*tiling.h_pad<=64){return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralMergeGates);}if(tiling.h>64&&tiling.eps>=0.0f){if(HasNormalInverseEpsilon(tiling.h,tiling.eps)){return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralWideTreeInverse);}return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralWideTree);}return KeyOf(KernelFamily::F00_GeneralFallback,kGeneralBase);}}


#ifndef SINKHORN_NORM_COMMON_PRIMITIVES_H_
#define SINKHORN_NORM_COMMON_PRIMITIVES_H_
#include "kernel_operator.h"
#define SINKHORN_AIV_NOINLINE static __aicore__ __attribute__((noinline))
#define SINKHORN_AIV_NOINLINE_ALIGNED static __aicore__ __attribute__((noinline))
namespace sinkhorn_norm{namespace primitives{using namespace AscendC;template<HardEvent event>
SN_INL void SyncEvent(TPipe&pipe){const auto id=pipe.FetchEventID(event);SetFlag<event>(id);WaitFlag<event>(id);}SN_INL void ComputeGateStable(
const LocalTensor<float>&gate,const LocalTensor<float>&tmp,const LocalTensor<float>&work,const LocalTensor<float>&denom,SN_U32 h,float eps,bool is_pre){Abs(tmp,gate,h);Mins(work,gate,0.0f,h);SN_VB;Muls(tmp,tmp,-1.0f,h);Exp(work,work,h);SN_VB;Exp(tmp,tmp,h);SN_VB;Adds(denom,tmp,1.0f,h);SN_VB;Div(gate,work,denom,h);SN_VB;if(is_pre){Adds(gate,gate,eps,h);}else{Muls(gate,gate,2.0f,h);}SN_VB;}SN_INL void ComputeGatePairStable(
const LocalTensor<float>&gates,const LocalTensor<float>&tmp,SN_U32 h,SN_U32 h_pad,float eps){const SN_U32 count=2*h_pad;auto abs_exp=tmp;auto numerator=tmp[count];auto denominator=tmp[2*count];Abs(abs_exp,gates,count);Mins(numerator,gates,0.0f,count);SN_VB;Muls(abs_exp,abs_exp,-1.0f,count);Exp(numerator,numerator,count);SN_VB;Exp(abs_exp,abs_exp,count);SN_VB;Adds(denominator,abs_exp,1.0f,count);SN_VB;Div(gates,numerator,denominator,count);SN_VB;Adds(gates,gates,eps,h);Muls(gates[h_pad],gates[h_pad],2.0f,h);SN_VB;}}}
