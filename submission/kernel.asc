__aicore__ inline void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,float eps,uint32_t iters){eps_ = eps;iters_ = iters;constexpr uint32_t width = StaticH - 16;packedRowMask_[0] =
