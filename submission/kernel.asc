SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const sinkhorn_norm::TilingData&t){t_=t;const SN_U64 core=GetBlockIdx();start_=core*t.tokens_per_core +(core<t.extra_core_count ? core:t.extra_core_count);count_=t.tokens_per_core +(core<t.extra_core_count ? 1:0);input_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));pre_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));post_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));comb_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));const SN_U32 qr=(((t.h+3)/4*t.tile_tokens+7)/8*8);const SN_U32 rows=4*qr;const SN_U32 span=t.h_pad*t.tile_tokens;const SN_U32 tmp=8*rows;const SN_U32 ones=rows>2*span ? rows:2*span;const SN_U32 prefix=(512-(256+4*tmp +4*rows)%512)%512/4;SN_U32 work=0;for(SN_U32 v=1;v<=t.tile_tokens;++v){const SN_U32 r=(((t.h+3)/4*v+7)/8*8);const SN_U32 n=8*r+(r%16 ? 64:0);if(n>work)work=n;}pipe_.InitBuffer(matrixBuffer_,t.matrix_bytes);pipe_.InitBuffer(gateBuffer_,2*t.gate_bytes);pipe_.InitBuffer(partialBuffer_,t.input_bytes);pipe_.InitBuffer(tmpBuffer_,4*tmp);pipe_.InitBuffer(resultBuffer_,4*rows);pipe_.InitBuffer(workBuffer_,4*(prefix+work));pipe_.InitBuffer(onesBuffer_,4*ones);pipe_.InitBuffer(denomBuffer_,4*span);const SN_U32 used=t.matrix_bytes+2*t.gate_bytes+t.input_bytes+
