div(mat,mat,tmp,1,1,1,1,8,8,8);if(!useFactors){SN_VM<float,MaskMode::NORMAL>(0,kColHEpsMask);vector_dup(mat,eps_,1,1,1,8,0);SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<H)-1);vector_dup(denom,eps_,1,1,1,8,0);}SN_V;SN_VM<float,MaskMode::NORMAL>(0,kMask);vadds(mat,mat,eps_,1,1,1,8,8);SN_V;if(!useFactors){RunDirectIterations(iters,mat,tmp,denom,result);ResetMask();return;}auto*at=SN_RC<SN_UB*>(transpose_.GetPhyAddr());auto*q=SN_RC<SN_UB*>(colFactor_.GetPhyAddr());auto*oldEps=SN_RC<SN_UB*>(epsFactor_.GetPhyAddr());SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});Gather(transpose_,matrix_[2*P],transposeIndex_,SN_U32{0},SN_U32{64});SN_V;SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});SN_VM<float,MaskMode::NORMAL>(0,kColHEpsMask);vector_dup(mat,eps_,1,1,1,8,0);vector_dup(at,eps_,1,1,1,8,0);SN_V;SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});vcgadd(q,at,1,1,1,8);SN_V;const bool modelEnabled=iters>=14&&eps_>=0x1p-24f&&eps_<=0x1p-10f;const SN_U32 checkpoint=iters/4;auto oldState=LocalTensor<float>(TPosition::VECCALC,3328,64);auto recentState=LocalTensor<float>(TPosition::VECCALC,3584,64);auto*old=SN_RC<SN_UB*>(oldState.GetPhyAddr());auto*recent=SN_RC<SN_UB*>(recentState.GetPhyAddr());bool forecastApplied=false;for(SN_U32 iter=1;iter<iters;++iter){if(modelEnabled&&(iter+1==checkpoint||iter==checkpoint)){auto saved=iter==checkpoint ? recent:old;AugmentedHalf(mat,at,q,p,tmp,oldEps,saved);AugmentedHalf(at,mat,p,q,tmp,oldEps,saved+P);if(iter==checkpoint){SN_U32 steps=iters-iter-1-(Tuned ? 1:4);if(TryTinyFactorForecast(p,q,old,recent,tmp,gTmp,result,steps)){if constexpr(Tuned)forecastApplied=true;iter+=steps;RestoreTinyEpsilon(mat,at,p,q,oldEps,gTmp);}}}else{AugmentedHalf(mat,at,q,p,tmp,oldEps);AugmentedHalf(at,mat,p,q,tmp,oldEps);}}SN_VM<float,MaskMode::NORMAL>(0,kMask);if constexpr(Tuned){if(forecastApplied){vmul(tmp,oldEps,q,1,1,1,0,8,8,0);SN_V;vdiv(mat,mat,tmp,1,1,1,1,8,8,8);}else{vdiv(tmp,mat,q,1,1,1,0,8,8,0);SN_V;vdiv(mat,tmp,oldEps,1,1,1,1,8,8,8);}}else{vdiv(tmp,mat,q,1,1,1,0,8,8,0);vbrcb(SN_RC<__ubuf__ SN_U32*>(gTmp),SN_RC<__ubuf__ SN_U32*>(p),1,8,1);SN_V;vdiv(mat,tmp,gTmp,1,1,1,1,8,8,8);}SN_V;ResetMask();}}SN_AI void RunDirectIterations(SN_U32 iters,SN_UB*mat,SN_UB*tmp,SN_UB*denom,SN_UB*result){for(SN_U32 iter=0;iter<iters;++iter){if(iter>0){SN_VM<float,MaskMode::NORMAL>(0,kRowSumMask);vcgadd(result,mat,1,1,1,8);SN_V;vbrcb(SN_RC<__ubuf__ SN_U32*>(tmp),SN_RC<__ubuf__ SN_U32*>(result),1,8,1);SN_V;SN_VM<float,MaskMode::NORMAL>(0,kMask);vdiv(mat,mat,tmp,1,1,1,1,8,8,8);SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<H)-1);vector_dup(denom,eps_,1,1,1,8,0);SN_V;}SN_VM<float,MaskMode::NORMAL>(0,(SN_U64{1}<<H)-1);vadd(denom,mat,denom,SN_SC<uint8_t>(H),1,1,1,0,1,0);SN_V;SN_VM<float,MaskMode::NORMAL>(0,kMask);vdiv(mat,mat,denom,1,1,1,0,8,8,0);SN_V;}}SN_AI bool TryTinyFactorForecast(
SN_UB*p,SN_UB*q,SN_UB*old,SN_UB*recent,SN_UB*delta,SN_UB*products,SN_UB*result,SN_U32&steps){constexpr auto live=kPreGateMask|kPostGateMask;SN_VM<float,MaskMode::NORMAL>(0,kPreGateMask);vsub(delta,p,recent,1,1,1,1,8,8,8);vsub(delta+P,q,recent+P,1,1,1,1,8,8,8);vmuls(products+6*P,p,-1.0f,1,1,1,8,8);vmuls(products+7*P,q,-1.0f,1,1,1,8,8);SN_VM<float,MaskMode::NORMAL>(0,live);vsub(delta+2*P,recent,old,1,1,1,1,8,8,8);SN_V;vmul(products,delta,delta+2*P,1,1,1,1,8,8,8);vmul(products+2*P,delta+2*P,delta+2*P,1,1,1,1,8,8,8);vmul(products+4*P,delta,delta,1,1,1,1,8,8,8);SN_V;vcadd(result,products,1,1,1,8,0);vcadd(result+P,products+2*P,1,1,1,8,0);vcadd(result+2*P,products+4*P,1,1,1,8,0);vcgmax(result+3*P,products+6*P,1,1,1,8);Sync<HardEvent::V_S>();const float dot=result[0],before=result[P],now=result[2*P];const float rate=dot/before;const bool fit=before>0x1p-40f&&now>=0.0f&&now<=0x1p-14f&&
rate>=0.0f&&rate<=0.65f&&
now-dot*rate<=0.25f*now&&
result[3*P]<=-0.125f&&result[3*P +1]<=-0.125f;if(fit){float weight=0.0f;if constexpr(Tuned){if(now>0x1p-18f||rate>0.5f||now-dot*rate>0.125f*now)
--steps;const float squared=rate*rate;const float pair=rate +squared;for(SN_U32 step=0;step<steps/2;++step)
weight=pair+squared*weight;if(steps%2!=0)
weight=rate*(1.0f+weight);}else{for(SN_U32 step=0;step<steps;++step)
weight=rate*(1.0f+weight);}SN_VM<float,MaskMode::NORMAL>(0,kPreGateMask);vaxpy(p,delta,weight,1,1,1,8,8);vaxpy(q,delta+P,weight,1,1,1,8,8);SN_V;}SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});return fit;}SN_AI void RestoreTinyEpsilon(
SN_UB*mat,SN_UB*at,SN_UB*p,SN_UB*q,SN_UB*rowBroadcast,SN_UB*colBroadcast){SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});vbrcb(SN_RC<__ubuf__ SN_U32*>(rowBroadcast),SN_RC<__ubuf__ SN_U32*>(p),1,8,1);vbrcb(SN_RC<__ubuf__ SN_U32*>(colBroadcast),SN_RC<__ubuf__ SN_U32*>(q),1,8,1);SN_V;SN_VM<float,MaskMode::NORMAL>(0,kColHEpsMask);vmuls(mat,rowBroadcast,eps_,1,1,1,8,8);vmuls(at,colBroadcast,eps_,1,1,1,8,8);SN_V;SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});}SN_AI void AugmentedHalf(
