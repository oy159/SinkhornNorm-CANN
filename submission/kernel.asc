template <HardEvent event>
__aicore__ inline void Sync(){SetFlag<event>(EVENT_ID0);WaitFlag<event>(EVENT_ID0);}__aicore__ inline void GatePair(){constexpr uint32_t count = 2 * P;auto absExp = tmp_;auto numerator = tmp_[count];auto denominator = tmp_[2 * count];Muls(absExp,matrix_,-1.0f,count);Duplicate(numerator,1.0f,count);Mins(absExp,absExp,80.0f,count);Exp(absExp,absExp,count);Adds(denominator,absExp,1.0f,count);Div(matrix_,numerator,denominator,count);Adds(matrix_,matrix_,eps_,StaticH);Muls(matrix_[P],matrix_[P],2.0f,StaticH);}template <bool Maximum>
__aicore__ inline void ReduceRows(){if constexpr (Maximum){Max(tmp_,matrix_[2 * P],matrix_[2 * P + 8],uint64_t{64},uint8_t{3},{1,3,3,8,24,24});Max(tmp_,tmp_,matrix_[2 * P + 16],packedRowMask_,uint8_t{3},{1,1,3,8,8,24});BlockReduceMax(result_,tmp_,int32_t{3},int32_t{64},1,1,8);}else {Add(tmp_,matrix_[2 * P],matrix_[2 * P + 8],uint64_t{64},uint8_t{3},{1,3,3,8,24,24});Add(tmp_,tmp_,matrix_[2 * P + 16],packedRowMask_,uint8_t{3},{1,1,3,8,8,24});BlockReduceSum(result_,tmp_,int32_t{3},int32_t{64},1,1,8);}}__aicore__ inline void Softmax(){ReduceRows<true>();Brcb(tmp_,result_,uint8_t{3},{1,8});Sub(matrix_[2 * P],matrix_[2 * P],tmp_,uint64_t{StaticH},static_cast<uint8_t>(StaticH),{1,1,0,3,3,1});Exp(matrix_[2 * P],matrix_[2 * P],StaticH * P);ReduceRows<false>();for (uint32_t b = 0;b < 3;++b){Brcb(columns_[8 * b],result_,uint8_t{3},{3,P});}Div(matrix_[2 * P],matrix_[2 * P],columns_,StaticH * P);Adds(matrix_[2 * P],matrix_[2 * P],eps_,StaticH * P);}__aicore__ inline void NormalizeColumns(){Duplicate(denom_,eps_,StaticH);Add(denom_,matrix_[2 * P],denom_,uint64_t{StaticH},static_cast<uint8_t>(StaticH),{1,1,1,0,3,0});Copy(columns_,denom_,uint64_t{P},static_cast<uint8_t>(StaticH),{1,1,3,0});Div(matrix_[2 * P],matrix_[2 * P],columns_,StaticH * P);}GlobalTensor<float> inputGm_,preGm_,postGm_,combGm_;LocalTensor<float> matrix_,tmp_,work_,denom_,result_,columns_;uint64_t packedRowMask_[2];uint32_t iters_;float eps_;};}template <uint32_t StaticH>
__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f04_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();sinkhorn_f04::NarrowSingleP24Kernel<StaticH> op;op.Init(mixes,pre,post,comb,tiling.eps,tiling.iters);op.Process();PipeBarrier<PIPE_ALL>();}
