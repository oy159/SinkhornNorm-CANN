SN_RC<SN_UB*>(gates_.GetPhyAddr()),SN_RC<SN_UB*>(tmp_.GetPhyAddr()),SN_RC<SN_UB*>(ones_.GetPhyAddr()),span_,t_.eps);SetFlag<HardEvent::V_MTE3>(EVENT_ID1);}SN_AI void CopyOutCombStrided(SN_U64 first,bool hasMoreTiles){const SN_U32 n=valid_*t_.h*t_.h;auto row=partial_.ReinterpretCast<int32_t>();auto token=dense_output_.ReinterpretCast<int32_t>();const int32_t reciprocal=SN_SC<int32_t>(((1u<<20)+t_.h-1)/t_.h);CreateVecIndex(input_index_,int32_t{0},n);SN_VB;Muls(row,input_index_,reciprocal,n);SN_VB;ShiftRight(row,row,int32_t{20},n);SN_VB;Muls(token,row,reciprocal,n);SN_VB;ShiftRight(token,token,int32_t{20},n);SN_VB;Muls(row,row,SN_SC<int32_t>(span_-t_.h),n);Muls(token,token,int32_t{16}-SN_SC<int32_t>(t_.h*span_),n);SN_VB;Add(input_index_,input_index_,row,n);SN_VB;Add(input_index_,input_index_,token,n);SN_VB;Muls(input_index_,input_index_,int32_t{4},n);SN_VB;Gather(dense_output_,matrix_,input_index_.ReinterpretCast<SN_U32>(),SN_U32{0},n);Sync<HardEvent::V_MTE3>();const DataCopyExtParams out{1,n*SN_U32{sizeof(float)},0,0,0};DataCopyPad(comb_[first*t_.h*t_.h],dense_output_,out);input_indexed_valid_=0;if(hasMoreTiles)Sync<HardEvent::MTE3_MTE2>();}TPipe pipe_;TBuf<TPosition::VECOUT>matrixBuffer_,gateBuffer_,denseOutputBuffer_;TBuf<TPosition::VECCALC>partialBuffer_,onesBuffer_,denomBuffer_,inputIndexBuffer_;LocalTensor<float>matrix_,gates_,partial_,tmp_,ones_,denom_,dense_output_;LocalTensor<int32_t>input_index_;GlobalTensor<float>input_,pre_,post_,comb_;sinkhorn_norm::TilingData t_;SN_U64 start_,count_;SN_U32 valid_,rows_,span_,rp_,ones_cap_,dense_gate_cap_,input_gate_cap_,zero_offset_,input_indexed_valid_;bool constants_ready_;};}}template<int=0>
__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f05_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::ShortNarrowArgs tiling){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);sinkhorn_norm::f05::NarrowP16ShortBatchKernel op;op.Init(mixes,pre,post,comb,tiling);op.Process();}
#endif  


#ifndef SINKHORN_NORM_KERNELS_F06_NARROW_P16_PAIRED_ROWS_H_
#define SINKHORN_NORM_KERNELS_F06_NARROW_P16_PAIRED_ROWS_H_
#include "kernel_operator.h"
namespace sinkhorn_norm{namespace f06{using namespace AscendC;static SN_INL void WideRoundMask(SN_U64 mask){SN_VM<float,MaskMode::NORMAL>(SN_U64{0},mask);}template<int Op>
static SN_INL void WideRoundSpan(
SN_UB*dst,SN_UB*a,SN_UB*b,SN_U32 count,float scalar=0.0f){SN_U32 first=0;while(count-first>=64){const SN_U32 left=(count-first)/64;const uint8_t repeats=left<255 ? left:255;if constexpr(Op==0)vadd(dst+first,a+first,b+first,repeats,1,1,1,8,8,8);if constexpr(Op==1)vadds(dst+first,a+first,scalar,repeats,1,1,8,8);if constexpr(Op==2)vdiv(dst+first,a+first,b+first,repeats,1,1,1,8,8,8);if constexpr(Op==3)vcopy(SN_RC<__ubuf__ SN_U32*>(dst+first),SN_RC<__ubuf__ SN_U32*>(a+first),repeats,1,1,8,8);if constexpr(Op==4)vmul(dst+first,a+first,b+first,repeats,1,1,1,8,8,8);first+=64*repeats;}if(first<count){WideRoundMask((SN_U64{1}<<(count-first))-1);if constexpr(Op==0)vadd(dst+first,a+first,b+first,1,1,1,1,8,8,8);if constexpr(Op==1)vadds(dst+first,a+first,scalar,1,1,1,8,8);if constexpr(Op==2)vdiv(dst+first,a+first,b+first,1,1,1,1,8,8,8);if constexpr(Op==3)vcopy(SN_RC<__ubuf__ SN_U32*>(dst+first),SN_RC<__ubuf__ SN_U32*>(a+first),1,1,1,8,8);if constexpr(Op==4)vmul(dst+first,a+first,b+first,1,1,1,1,8,8,8);WideRoundMask(~SN_U64{0});}}static SN_INL void WideRoundFullRepeatsAdd(
