vmuls(dst+offset,a+offset,scalar,repeats,1,1,8,8);offset+=current;}SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});}}template<bool Maximum>
F12_FN void WideRows(
Fp mat,Fp part,Fp res,SN_U32 rows,SN_U32 blocks){if ASCEND_IS_AIV{const uint8_t groups=SN_SC<uint8_t>(rows/8);auto dst=part;auto src=mat;for(SN_U32 block=0;block<blocks;++block){if constexpr(Maximum)
vcgmax(dst,src,groups,1,1,8);else
vcgadd(dst,src,groups,1,1,8);dst+=rows;src+=rows*8;}SN_V;for(SN_U32 planes=blocks;planes>2;){const SN_U32 pairs=planes/2,upper=planes-pairs;WideSpan<Maximum?4:0>(part,part,part+upper*rows,pairs*rows);SN_V;planes=upper;}WideSpan<Maximum?4:0>(res,part,part+rows,rows);SN_V;}}F12_FN void RowFold(
Fp mat,Fp part,Fp res,SN_U32 rows,SN_U32 blocks,SN_U32 capacity){if ASCEND_IS_AIV{const SN_U32 plane=8*rows;if((plane*sizeof(float)&511u)==0||
blocks<4||capacity<2*plane+128){WideRows<false>(mat,part,res,rows,blocks);return;}const SN_U32 phase=SN_SC<SN_U32>(
SN_RC<SN_U64>(part)-
SN_RC<SN_U64>(mat))&511u;auto first=part+((256u-phase)&511u)/sizeof(float);auto second=first+plane;const uint8_t repeats=SN_SC<uint8_t>(rows/8);WideMask(~SN_U64{0});vadd(first,mat,mat+plane,repeats,1,1,1,8,8,8);vadd(second,mat+2*plane,mat+3*plane,repeats,1,1,1,8,8,8);for(SN_U32 block=4;block<blocks;++block){auto dst=(block&1)?second:first;vadd(dst,dst,mat+block*plane,repeats,1,1,1,8,8,8);}SN_V;vadd(first,first,second,repeats,1,1,1,8,8,8);SN_V;vcgadd(res,first,repeats,1,1,8);SN_V;}}F12_FN void WideColAdd(
Fp dst,Fp a,Fp b,SN_U32 count,SN_U32 slabs,SN_U32 ds,SN_U32 as,SN_U32 bs){if ASCEND_IS_AIV{const uint8_t repeats=SN_SC<uint8_t>(slabs);for(SN_U32 first=0;first<count;first+=64){const SN_U32 width=count-first<64?count-first:64;if(width<64)WideMask((SN_U64{1}<<width)-1);vadd(dst+first,a+first,b+first,repeats,1,1,1,ds,as,bs);if(width<64)WideMask(~SN_U64{0});}}}F12_FN void Cols(
Fp mat,Fp part,Fp ones,Fp denom,Fp tmp,SN_U32 h,SN_U32 valid,float eps,bool sumOnly=false,Fp capture=nullptr){if ASCEND_IS_AIV{if(h==88){const SN_U32 slabs=11*valid;const SN_U32 stride=9;auto buf0=part;auto buf1=part+slabs*72;WideColAdd(buf0,mat+0*64,mat+1*64,64,slabs,stride,88,88);WideColAdd(buf1,mat+2*64,mat+3*64,64,slabs,stride,88,88);WideColAdd(buf0,buf0,mat+4*64,64,slabs,stride,stride,88);WideColAdd(buf1,buf1,mat+5*64,64,slabs,stride,stride,88);WideColAdd(buf0,buf0,mat+6*64,64,slabs,stride,stride,88);WideColAdd(buf1,buf1,mat+7*64,64,slabs,stride,stride,88);WideColAdd(buf0,buf0,mat+8*64,64,slabs,stride,stride,88);WideColAdd(buf1,buf1,mat+9*64,64,slabs,stride,stride,88);WideColAdd(buf0,buf0,mat+10*64,64,slabs,stride,stride,88);SN_V;WideColAdd(buf0,buf0,buf1,64,slabs,stride,stride,stride);SN_V;const SN_U32 span=slabs*8;const uint8_t nSpan=SN_SC<uint8_t>((span+63)/64);WideMask(SN_U64{0xffffffff});vadd(tmp,buf0,buf0+32,SN_SC<uint8_t>(slabs),SN_SC<uint8_t>(slabs),1,1,1,stride,stride);SN_V;SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,2*span);vadd(tmp,tmp,tmp+2*span,SN_SC<uint8_t>((2*span+63)/64),1,1,1,8,8,8);SN_V;SN_VM<float,MaskMode::COUNTER>(0,span);vadd(denom,tmp,tmp+span,nSpan,1,1,1,8,8,8);SN_V;if(capture){vsub(capture,denom,ones,nSpan,1,1,1,8,8,8);SN_V;}if(sumOnly){SetMaskNorm();WideMask(~SN_U64{0});return;}vadds(denom,denom,eps,nSpan,1,1,8,8);vdiv(denom,ones,denom,nSpan,1,1,1,8,8,8);SN_V;SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});auto mCol=mat;auto dCol=denom;for(SN_U32 slab=0;slab<slabs;++slab){vmul(mCol,mCol,dCol,11,1,1,0,8,8,0);mCol+=88*8;dCol+=8;}SN_V;return;}const SN_U32 q=h/4,slabs=h/8*valid;WideColAdd(part,mat,mat+q*8,q*8,slabs,q,h,h);SN_V;WideColAdd(part,part,mat+2*q*8,q*8,slabs,q,q,h);SN_V;WideColAdd(part,part,mat+3*q*8,q*8,slabs,q,q,h);SN_V;SN_U32 height=q;while(height>8){const SN_U32 half=height/2,upper=height-half;WideColAdd(part,part,part+upper*8,half*8,slabs,q,q,q);SN_V;height=upper;}const SN_U32 span=slabs*8;const SN_U32 half=hei