template <HardEvent Event>
__aicore__ inline void Sync(){SetFlag<Event>(EVENT_ID0);WaitFlag<Event>(EVENT_ID0);}__aicore__ inline void SeedOutputIndices(LocalTensor<int32_t> index,uint32_t elements){for (uint32_t token = 0;token < 8;++token){for (uint32_t element = 0;element < elements;++element){index.SetValue(token * elements + element,static_cast<int32_t>(4 * (element * cap_ + token)));}}}__aicore__ inline void ExpandOutputIndices(LocalTensor<int32_t> index,uint32_t elements){for (uint32_t token = 8;token < cap_;token += 8){Adds(index[token * elements],index,static_cast<int32_t>(4 * token),8 * elements);}PipeBarrier<PIPE_V>();}__aicore__ inline LocalTensor<float> Cell(uint32_t row,uint32_t col){return planes_[(2 * h_ + row * h_ + col)* cap_];}__aicore__ inline void Gates(uint32_t valid){const bool full = valid == cap_;const uint32_t n = full ? 2 * h_ * cap_ : valid;auto a = full ? dense_ : a_;auto b = full ? dense_[n] : b_;for (uint32_t g = 0;g < (full ? 1 : 2 * h_);++g){auto x = planes_[g * cap_];Duplicate(b,1.0f,n);Muls(a,x,-1.0f,n);PipeBarrier<PIPE_V>();Mins(a,a,80.0f,n);PipeBarrier<PIPE_V>();Exp(a,a,n);PipeBarrier<PIPE_V>();Adds(a,a,1.0f,n);PipeBarrier<PIPE_V>();Div(x,b,a,n);PipeBarrier<PIPE_V>();if (full){Adds(x,x,t_.eps,h_ * cap_);Muls(x[h_ * cap_],x[h_ * cap_],2.0f,h_ * cap_);}else if (g < h_){Adds(x,x,t_.eps,n);}else {Muls(x,x,2.0f,n);}PipeBarrier<PIPE_V>();}}__aicore__ inline void Softmax(uint32_t valid){for (uint32_t row = 0;row < h_;++row){Max(a_,Cell(row,0),Cell(row,1),valid);PipeBarrier<PIPE_V>();for (uint32_t col = 2;col < h_;++col){Max(a_,a_,Cell(row,col),valid);PipeBarrier<PIPE_V>();}for (uint32_t col = 0;col < h_;++col){Sub(Cell(row,col),Cell(row,col),a_,valid);}PipeBarrier<PIPE_V>();for (uint32_t col = 0;col < h_;++col){Exp(Cell(row,col),Cell(row,col),valid);}PipeBarrier<PIPE_V>();RowSum(row,valid);for (uint32_t col = 0;col < h_;++col){Div(Cell(row,col),Cell(row,col),b_,valid);}PipeBarrier<PIPE_V>();for (uint32_t col = 0;col < h_;++col){Adds(Cell(row,col),Cell(row,col),t_.eps,valid);}PipeBarrier<PIPE_V>();}}__aicore__ inline void RowSum(uint32_t row,uint32_t valid){Add(b_,Cell(row,0),Cell(row,1),valid);PipeBarrier<PIPE_V>();for (uint32_t col = 2;col < h_;++col){Add(b_,b_,Cell(row,col),valid);PipeBarrier<PIPE_V>();}}__aicore__ inline void FusedTwoByTwoRound(uint32_t valid){auto m00 = Cell(0,0);auto m01 = Cell(0,1);auto m10 = Cell(1,0);auto m11 = Cell(1,1);Add(a_,m00,m01,valid);Add(b_,m10,m11,valid);PipeBarrier<PIPE_V>();Adds(a_,a_,t_.eps,valid);Adds(b_,b_,t_.eps,valid);PipeBarrier<PIPE_V>();Mul(c_,a_,b_,valid);PipeBarrier<PIPE_V>();Muls(c_,c_,t_.eps,valid);Mul(m00,m00,b_,valid);Mul(m01,m01,b_,valid);Mul(m10,m10,a_,valid);Mul(m11,m11,a_,valid);PipeBarrier<PIPE_V>();Add(a_,m00,m10,valid);Add(b_,m01,m11,valid);PipeBarrier<PIPE_V>();Add(a_,a_,c_,valid);Add(b_,b_,c_,valid);PipeBarrier<PIPE_V>();Div(m00,m00,a_,valid);Div(m10,m10,a_,valid);Div(m01,m01,b_,valid);Div(m11,m11,b_,valid);PipeBarrier<PIPE_V>();}__aicore__ inline void Columns(uint32_t valid){for (uint32_t col = 0;col < h_;++col){Duplicate(c_,t_.eps,valid);PipeBarrier<PIPE_V>();for (uint32_t row = 0;row < h_;++row){Add(c_,Cell(row,col),c_,valid);PipeBarrier<PIPE_V>();}for (uint32_t row = 0;row < h_;++row){Div(Cell(row,col),Cell(row,col),c_,valid);}PipeBarrier<PIPE_V>();}}TPipe pipe_;TBuf<TPosition::VECCALC> denseBuffer_,planeBuffer_,indexBuffer_,scratchBuffer_;GlobalTensor<float> input_,pre_,post_,comb_;LocalTensor<float> dense_,planes_,a_,b_,c_;LocalTensor<int32_t> inIndex_,gateIndex_,matrixIndex_;sinkhorn_norm::TilingData t_;uint64_t start_,count_;uint32_t h_,width_,cap_;bool indices_ready_;};}}template <int = 0>
