for(SN_U32 j=0;j<9;++j)Adds<int32_t,false>(in[8*j],ts,SN_SC<int32_t>(24+4*j),8);SN_VB;ResetMask();Sync<HardEvent::MTE2_V>();Gather(matrix_,dense,in.ReinterpretCast<SN_U32>(),SN_U32{0},128);SN_VB;Compute(iters);Gather(dense,matrix_,out.ReinterpretCast<SN_U32>(),SN_U32{0},72);Sync<HardEvent::V_MTE3>();const DataCopyExtParams result{1,36*valid,0,0,0};DataCopyPad(output_[9*first],dense,result);}private:
template<HardEvent E>SN_AI void Sync(){SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);}SN_AI void Compute(SN_U32 iters){if ASCEND_IS_AIV{auto*m=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto*r=SN_RC<SN_UB*>(row_.GetPhyAddr());auto*d=SN_RC<SN_UB*>(col_.GetPhyAddr());SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,0xffffff);vmax(r,m+8,m,1,1,3,3,0,0,0);SN_V;vmax(r,m+16,r,1,1,3,1,0,0,0);SN_V;vsub(m,m,r,3,1,1,0,3,3,1);SN_V;SetMaskCount();set_vector_mask(SN_U64{0},SN_U64{72});vexp(m,m,1,1,1,8,8);SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,0xffffff);vector_dup(r,0.0f,1,1,1,8,0);SN_V;vadd(r,m,r,3,1,3,1,0,1,0);SN_V;vdiv(m,m,r,3,1,1,0,3,3,1);vector_dup(d,eps_,1,1,1,8,0);SN_V;SetMaskCount();set_vector_mask(SN_U64{0},SN_U64{72});vadds(m,m,eps_,1,1,1,8,8);SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,0xffffff);SN_V;for(SN_U32 i=0;i<iters;++i){vadd(d,m,d,3,1,1,1,0,3,0);SN_V;vdiv(m,m,d,3,1,1,1,3,3,0);vector_dup(r,eps_,1,1,1,8,0);SN_V;if(i+1<iters){vadd(r,m,r,3,1,3,1,0,1,0);SN_V;vdiv(m,m,r,3,1,1,0,3,3,1);vector_dup(d,eps_,1,1,1,8,0);SN_V;}}ResetMask();}}GlobalTensor<float>input_,output_;LocalTensor<float>matrix_,row_,col_;SN_U32 tokens_;float eps_;};__aicore__ constexpr inline SN_U64 GateWord(SN_U32 w,SN_U32 col){SN_U64 mask=0;for(SN_U32 b=0;b<64;++b){const SN_U32 c=(64*w+b)%15;if(c>=col&&c<col+3)mask|=SN_U64{1}<<b;}return mask;}template<SN_U32 W=0>
SN_AI void ThreeGateMasks(LocalTensor<SN_U64>a,LocalTensor<SN_U64>b){constexpr auto x=GateWord(W,0),y=GateWord(W,3);a.SetValue(W,x);b.SetValue(W,y);if constexpr(W<15)ThreeGateMasks<W+1>(a,b);}SN_AI void ThreeGateRole(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,SN_U32 tokens,float eps){GlobalTensor<float>input,outPre,outPost;input.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));outPre.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));outPost.SetGlobalBuffer(SN_RC<__gm__ float*>(post));const SN_U32 n=3*tokens,p=(n+63)/64*64;auto data=LocalTensor<float>(TPosition::VECCALC,0,1024);auto gate=LocalTensor<float>(TPosition::VECCALC,4096,512);auto work=LocalTensor<float>(TPosition::VECCALC,6144,512);auto ones=LocalTensor<float>(TPosition::VECCALC,8192,512);auto pa=LocalTensor<SN_U64>(TPosition::VECCALC,10240,16);auto pb=LocalTensor<SN_U64>(TPosition::VECCALC,10368,16);const DataCopyExtParams in{1,60*tokens,0,0,0};const DataCopyPadExtParams<float>pad{false,0,0,0.0f};DataCopyPad(data,input,in,pad);Duplicate(gate,0.0f,2*p);Duplicate(ones,1.0f,2*p);ThreeGateMasks(pa,pb);SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);SN_VB;SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);if ASCEND_IS_AIV{auto*g=SN_RC<SN_UB*>(gate.GetPhyAddr());auto*w=SN_RC<SN_UB*>(work.GetPhyAddr());auto*o=SN_RC<SN_UB*>(ones.GetPhyAddr());auto*d=SN_RC<__ubuf__ SN_U32*>(data.GetPhyAddr());SetMaskCount();set_vector_mask(SN_U64{0},SN_U64{15*tokens});vreducev2(SN_RC<__ubuf__ SN_U32*>(g),d,SN_RC<__ubuf__ SN_U32*>(pa.GetPhyAddr()),1,1,0,8,0);vreducev2(SN_RC<__ubuf__ SN_U32*>(g+p),d,SN_RC<__ubuf__ SN_U32*>(pb.GetPhyAddr()),1,1,0,8,0);SetMaskNorm();SN_VM<float,MaskMode::NORMAL>(0,~SN_U64{0});SN_V;const uint8_t r=2*p/64;vmuls(w,g,-1.0f,r,1,1,8,8);SN_V;vmins(w,w,80.0f,r,1,1,8,8);SN_V;vexp(w,w,r,1,1,8,8);SN_V;vadds(w,w,1.0f,r,1,1,8,8);SN_V;vdiv(g,o,w,r,1,1,1,8,8,8);SN_V;vadds(g,g,eps,p/64,1,1,8,8);vmuls(g+p,g+p,2.0f,p/64,1,1,8,8);}SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);const DataCopyExtParams out{1,4*n,0,0,0};DataCopyPad(outPre,gate,out);DataCopyPad(outPost,gate[p],out);}template<SN_U32 H>
SN_AI void RunBatchedGateRole(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,SN_U32 tokens,float eps){GlobalTensor<float>input,preOut,postOut;input.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));preOut.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));postOut.SetGlobalBuffer(SN_RC<__gm__ float*>(post));TPipe pipe;TBuf<TPosition::VECCALC>arena;pipe.InitBuffer(arena,32768);auto dense=arena.Get<float>();auto gates=dense[4096];auto work=dense[5120];auto ones=dense[6144];auto index=dense[7168].template ReinterpretCast<int32_t>();auto row=dense[7680].template ReinterpretCast<int32_t>();const SN_U32 n=H*tokens,p=(n+7)/8*8;const DataCopyExtParams in{1,4*H*(H+2)*tokens,0,0,0};const DataCopyPadExtParams<float>noPad{false,0,0,0.0f};DataCopyPad(dense,input,in,noPad);CreateVecIndex(index,int32_t{0},n);Duplicate(gates,0.0f,2*p);Duplicate(ones,1.0f,2*p);SN_VB;Muls(row,index,int32_t{((1<<20)+H-1)/H},n);SN_VB;ShiftRight(row,row,int32_t{20},n);SN_VB;Muls(row,row,int32_t{H*(H+1)},n);SN_VB;Add(index,index,row,n);SN_VB;Muls(index,index,int32_t{4},n);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);SN_VB;Gather(gates,dense,index.ReinterpretCast<SN_U32>(),SN_U32{0},n);Gather(gates[p],dense,index.ReinterpretCast<SN_U32>(),SN_U32{4*H},n);SN_VB;Muls(work,gates,-1.0f,2*p);SN_VB;Mins(work,work,80.0f,2*p);SN_VB;Exp(work,work,2*p);SN_VB;Adds(work,work,1.0f,2*p);SN_VB;Div(gates,ones,work,2*p);SN_VB;Adds(gates,gates,eps,n);Muls(gates[p],gates[p],2.0f,n);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);const DataCopyExtParams out{1,4*n,0,0,0};DataCopyPad(preOut,gates,out);DataCopyPad(postOut,gates[p],out);}}template<SN_U32 H>
__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f02_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();if(GetBlockNum()==tiling.core_count+1){if(GetBlockIdx()==tiling.core_count){sinkhorn_norm::RunBatchedGateRole<H>(mixes,pre,post,tiling.token_count,tiling.eps);}else{sinkhorn_norm::F02_TinySingle<H>op;op.Init(mixes,pre,post,comb,tiling.eps);op.template Process<true>(tiling.iters);}}else{sinkhorn_norm::F02_TinySingle<H>op;op.Init(mixes,pre,post,comb,tiling.eps);op.Process(tiling.iters);}PipeBarrier<PIPE_ALL>();}template<SN_U32 H>
__global__ __aicore__ __attribute__((aligned(64),section(".sinkhorn_tiny_long_entry")))
void sinkhorn_f02_long_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TilingData tiling){using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();if(GetBlockNum()==tiling.core_count+1){if(GetBlockIdx()==tiling.core_count){sinkhorn_norm::RunBatchedGateRole<H>(mixes,pre,post,tiling.token_count,tiling.eps);}else{sinkhorn_norm::F02_TinySingle<H,true>op;op.Init(mixes,pre,post,comb,tiling.eps);op.template Process<true>(tiling.iters);}}else{sinkhorn_norm::F02_TinySingle<H,true>op;op.Init(mixes,pre,post,comb,tiling.eps);op.Process(tiling.iters);}PipeBarrier<PIPE_ALL>();}template<SN_U32 H>
__global__ __aicore__ __attribute__((aligned(64)))void sinkhorn_f02_kernel(
GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,sinkhorn_norm::TinyThreeRowArgs args){static_assert(H==3,"Fused three-row geometry");using namespace AscendC;KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);InitSocState();if(GetBlockIdx()+1==GetBlockNum()){sinkhorn_norm::ThreeGateRole(mixes,pre,post,args.tokens,args.eps);}else{sinkhorn_norm::F02_ThreeRowPlanes op;op.Init(mixes,comb,args.tokens,args.eps);op.Process(args.iters);}PipeBarrier<PIPE_ALL>();}
