namespace sinkhorn_norm{namespace kernels{using namespace AscendC;SN_AI SN_U32 GetCompactPlaneCapacity(const sinkhorn_norm::TilingData&t){const SN_U64 h=t.h;const SN_U64 gather_limit=(255/(h*h))*64;const SN_U64 width=h*(h+2);const SN_U64 plane_capacity=t.input_bytes/(4*width);const bool plane_budget=
t.gate_bytes==0&&plane_capacity%64==0&&
SN_U64{t.input_bytes}==4*width*plane_capacity&&
t.matrix_bytes==t.input_bytes&&
(SN_U64{t.scratch_bytes}==4*(h*h+h+3)*plane_capacity||
SN_U64{t.scratch_bytes}==4*(h*h+h+4)*plane_capacity);if(plane_budget){return SN_SC<SN_U32>(
plane_capacity<gather_limit ? plane_capacity:gather_limit);}const SN_U64 bytes=SN_U64{t.input_bytes}+t.matrix_bytes+
