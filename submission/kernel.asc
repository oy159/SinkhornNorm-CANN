SN_UB*snapshot,SN_UB*sum,SN_UB*ones,SN_U32 count,SN_U32 capacity){if ASCEND_IS_AIV{SetMaskCount();if(count<capacity){SN_VM<float,MaskMode::COUNTER>(0,capacity);vector_dup(snapshot,0.0f,(capacity+63)/64,1,1,8,0);SN_V;}SN_VM<float,MaskMode::COUNTER>(0,count);vsub(snapshot,sum,ones,(count+63)/64,1,1,1,8,8,8);SN_V;SetMaskNorm();WideRoundMask(~SN_U64{0});}}static SN_INL bool ShortForecastAdmitted(
SN_UB*recent,SN_UB*scratch,SN_U32 span){if ASCEND_IS_AIV{SetMaskCount();SN_VM<float,MaskMode::COUNTER>(0,span);vabs(scratch,recent,1,1,1,8,8);SN_V;vcgmax(scratch+span,scratch,1,1,1,8);SN_V;SetMaskNorm();const SN_U32 groups=span/8;WideRoundMask((SN_U64{1}<<groups)-1);vcgmax(scratch,scratch+span,1,1,1,8);WideRoundMask(~SN_U64{0});const auto event=GetTPipePtr()->FetchEventID(HardEvent::V_S);SetFlag<HardEvent::V_S>(event);WaitFlag<HardEvent::V_S>(event);constexpr float bound=0x1p-10f;return scratch[0]<=bound&&(groups<=8||scratch[1]<=bound);}return false;}template<bool Multiply>
static SN_INL void ScaleShortColumns(
SN_UB*matrix,SN_UB*factor,SN_U32 h,SN_U32 span){if ASCEND_IS_AIV{const uint8_t stride=SN_SC<uint8_t>(span/8);for(SN_U32 col=0;col<span;col+=64){if(span-col<64)WideRoundMask((SN_U64{1}<<(span-col))-1);if constexpr(Multiply)
vmul(matrix+col,matrix+col,factor+col,h,1,1,1,stride,stride,0);else
vdiv(matrix+col,matrix+col,factor+col,h,1,1,1,stride,stride,0);}SN_V;}}static SN_INL void RunNarrowShortBatchCompleteRounds(
SN_UB*matrix,SN_UB*partial,SN_UB*ones,SN_UB*denom,SN_U32 h,SN_U32 valid,float eps,SN_U32 iters,SN_UB*history,SN_U32 historyCapacity,SN_U32 partialCapacity){if ASCEND_IS_AIV{const SN_U32 rows=h*valid,span=16*valid;const SN_U32 groups4=(rows+3)/4;const SN_U32 pairs32=(rows+31)/32;const SN_U32 rowRepeats=(rows+63)/64;const SN_U32 spanRepeats=(span+63)/64;const SN_U32 matRepeats=(rows*16+63)/64;const SN_U32 q4Repeats=(4*span+63)/64;const SN_U32 q4Stride=q4Repeats*64;const SN_U32 q2Repeats=(2*span+63)/64;const SN_U32 broadcasts=(rows+7)/8;const SN_U64 pairMask=
((SN_U64{1}<<h)-1)*SN_U64{0x0001000100010001};constexpr SN_U32 steps=6,tail=8;const bool forecast=iters>=4+steps+tail&&eps>=0x1p-24f&&
eps<=1.0e-5f&&historyCapacity>=7*span&&partialCapacity>=10*span;const SN_U32 checkpoint=forecast ? iters-steps-tail:iters;WideRoundMask(~SN_U64{0});vbrcb(SN_RC<__ubuf__ SN_U32*>(partial),SN_RC<__ubuf__ SN_U32*>(denom),2,16,broadcasts);vbrcb(SN_RC<__ubuf__ SN_U32*>(partial+8),SN_RC<__ubuf__ SN_U32*>(denom),2,16,broadcasts);SN_V;WideRoundMask(pairMask);vsub(matrix,matrix,partial,groups4,1,1,1,8,8,8);SN_V;WideRoundMask(~SN_U64{0});vexp(matrix,matrix,matRepeats,1,1,8,8);SN_V;for(SN_U32 round=0;round<iters;++round){const bool predict=round==checkpoint&&
ShortForecastAdmitted(history+((round-1)%2)*2*span,partial,span);const bool measure=forecast&&round<checkpoint&&round+2>=checkpoint;auto snapshot=history+(round%2)*2*span;auto columns=history+6*span;if(predict){ForecastDenominatorProduct<steps>(denom,columns,partial,history+4*span,ones,history+((round-1)%2)*2*span,snapshot,span,eps);}else{WideRoundMask(pairMask);vcgadd(partial,matrix,groups4,1,1,8);SN_V;WideRoundMask(~SN_U64{0});vcpadd(denom,partial,pairs32,1,1,8);SN_V;if(measure)CaptureShortDenominator(snapshot,denom,ones,rows,span);if(round>0){vadds(denom,denom,eps,rowRepeats,1,1,8,8);SN_V;}}vbrcb(SN_RC<__ubuf__ SN_U32*>(partial),SN_RC<__ubuf__ SN_U32*>(denom),2,16,broadcasts);vbrcb(SN_RC<__ubuf__ SN_U32*>(partial+8),SN_RC<__ubuf__ SN_U32*>(denom),2,16,broadcasts);SN_V;if(predict)
vmul(matrix,matrix,partial,matRepeats,1,1,1,8,8,8);else
vdiv(matrix,matrix,partial,matRepeats,1,1,1,8,8,8);SN_V;if(predict){ScaleShortColumns<true>(matrix,columns,h,span);round+=steps-1;continue;}if(round==0){vadds(matrix,matrix,eps,matRepeats,1,1,8,8);SN_V;if(h<16){vector_dup(matrix+rows*16,0.0f,1,1,1,8,8);SN_V;}}vadd(partial,matrix,matrix+4*span,q4Repeats,1,1,1,8,8,8);if(h>12){vadd(partial+q4Stride,matrix+8*span,matrix+12*span,q4Repeats,1,1,1,8,8,8);}SN_V;if(h>12){vadd(partial,partial,partial+q4Stride,q4Repeats,1,1,1,8,8,8);SN_V;}else if(h>8){vadd(partial,partial,matrix+8*span,q4Repeats,1,1,1,8,8,8);SN_V;}vadd(partial,partial,partial+2*span,q2Repeats,1,1,1,8,8,8);SN_V;vadd(denom,partial,partial+span,spanRepeats,1,1,1,8,8,8);SN_V;if(measure)CaptureShortDenominator(snapshot+span,denom,ones,span,span);vadds(denom,denom,eps,spanRepeats,1,1,8,8);SN_V;ScaleShortColumns<false>(matrix,denom,h,span);}}}class NarrowP16ShortBatchKernel{public:
SN_AI void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const sinkhorn_norm::ShortNarrowArgs&t){t_.eps=t.eps;t_.iters=t.iters;t_.h=t.h;t_.h_pad=16;t_.core_count=GetBlockNum();t_.tokens_per_core=t.owner;t_.extra_core_count=t.extra;t_.token_count=SN_U64{t.owner}*t_.core_count+t.extra;t_.tile_tokens=t.owner+(t.extra!=0);t_.input_width=t.h*(t.h+2);t_.input_bytes=32*t.h*t_.tile_tokens;t_.matrix_bytes=64*t.h*t_.tile_tokens;t_.gate_bytes=64*t_.tile_tokens;t_.scratch_bytes=0;const SN_U64 core=GetBlockIdx();start_=core*t_.tokens_per_core +
(core<t_.extra_core_count ? core:t_.extra_core_count);count_=t_.tokens_per_core +(core<t_.extra_core_count ? 1:0);input_.SetGlobalBuffer(SN_RC<__gm__ float*>(mixes));pre_.SetGlobalBuffer(SN_RC<__gm__ float*>(pre));post_.SetGlobalBuffer(SN_RC<__gm__ float*>(post));comb_.SetGlobalBuffer(SN_RC<__gm__ float*>(comb));rp_=(t_.h*t_.tile_tokens+7)/8*8;const SN_U32 span=t_.tile_tokens*t_.h_pad;ones_cap_=rp_>2*span ? rp_:2*span;const SN_U32 tmp=8*rp_>6*span ? 8*rp_:6*span;dense_gate_cap_=(t_.h*t_.tile_tokens+63)/64*64;const SN_U32 matrixCap=(t_.h*t_.h*t_.tile_tokens+63)/64*64;zero_offset_=2*dense_gate_cap_+matrixCap;input_gate_cap_=(2*span+63)/64*64;const SN_U32 inputMatrixCap=(t_.h*span+63)/64*64;pipe_.InitBuffer(matrixBuffer_,16*span*sizeof(float)+256);pipe_.InitBuffer(gateBuffer_,2*t_.gate_bytes+256);pipe_.InitBuffer(partialBuffer_,t_.input_bytes+(tmp +2*rp_)*sizeof(float)+256);pipe_.InitBuffer(onesBuffer_,ones_cap_*sizeof(float)+256);pipe_.InitBuffer(denomBuffer_,span*sizeof(float)+256);pipe_.InitBuffer(denseOutputBuffer_,4*zero_offset_+32);pipe_.InitBuffer(inputIndexBuffer_,4*(input_gate_cap_+inputMatrixCap));dense_output_=denseOutputBuffer_.Get<float>();matrix_=matrixBuffer_.Get<float>();gates_=gateBuffer_.Get<float>();partial_=partialBuffer_.Get<float>();tmp_=partial_[t_.input_bytes/sizeof(float)];ones_=onesBuffer_.Get<float>();denom_=denomBuffer_.Get<float>();input_index_=inputIndexBuffer_.Get<int32_t>();constants_ready_=false;input_indexed_valid_=0;}SN_AI void Process(){for(SN_U64 offset=0;offset<count_;offset+=t_.tile_tokens){const SN_U64 first=start_+offset;const SN_U64 left=count_-offset;valid_=left<t_.tile_tokens ? SN_SC<SN_U32>(left):t_.tile_tokens;rows_=t_.h*valid_;span_=t_.h_pad*valid_;CopyInAndBuildMaps(first);GatesAndRowMax();WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);const SN_U32 gStride=(valid_-1)*t_.h_pad/8;const DataCopyExtParams gOut{1,4*t_.h,gStride,0,0};for(SN_U32 token=0;token<valid_;++token){const SN_U64 base=first+token;DataCopyPad(pre_[base*t_.h],gates_[token*t_.h_pad],gOut);DataCopyPad(post_[base*t_.h],gates_[span_+token*t_.h_pad],gOut);}SetMaskNorm();RunNarrowShortBatchCompleteRounds(
SN_RC<SN_UB*>(matrix_.GetPhyAddr()),SN_RC<SN_UB*>(partial_.GetPhyAddr()),SN_RC<SN_UB*>(ones_.GetPhyAddr()),SN_RC<SN_UB*>(denom_.GetPhyAddr()),t_.h,valid_,t_.eps,t_.iters,SN_RC<SN_UB*>(input_index_.GetPhyAddr()),input_index_.GetSize(),partial_.GetSize());ResetMask();CopyOutCombStrided(first,offset+t_.tile_tokens<count_);}}private:
template<HardEvent event>
SN_AI void Sync(){SetFlag<event>(EVENT_ID0);WaitFlag<event>(EVENT_ID0);}SN_AI void SetDenseInputPaddingAnchor(LocalTensor<int32_t>tensor,SN_U32 rows){const SN_U32 live=t_.h%8;if(live==0)return;const int32_t anchorByteOffset=SN_SC<int32_t>(4*zero_offset_);SN_U64 mask[2]={SN_U64{0xff}^((SN_U64{1}<<live)-1),0};for(SN_U32 first=0;first<rows;first+=248){const SN_U32 n=rows-first<248 ? rows-first:248;Duplicate(tensor[first*t_.h_pad+t_.h_pad-8],anchorByteOffset,mask,SN_SC<uint8_t>(n),uint16_t{1},SN_SC<uint8_t>(t_.h_pad/8));}SN_VB;}SN_AI void BuildDenseInputMaps(){auto token=partial_.template ReinterpretCast<int32_t>();CreateVecIndex(input_index_,int32_t{0},span_);SN_VB;ShiftRight(token,input_index_,int32_t{4},span_);SN_VB;Muls(token,token,SN_SC<int32_t>(t_.input_width-16),span_);SN_VB;Add(input_index_,input_index_,token,span_);SN_VB;Muls(input_index_,input_index_,int32_t{4},span_);SN_VB;for(SN_U32 planes=1;planes<t_.h+2;planes*=2){const SN_U32 n=
t_.h+2-planes<planes ? t_.h+2-planes:planes;Adds(input_index_[planes*span_],input_index_,SN_SC<int32_t>(4*planes*t_.h),n*span_);SN_VB;}SetDenseInputPaddingAnchor(input_index_[2*span_],rows_);}SN_AI void CopyInAndBuildMaps(SN_U64 first){const DataCopyExtParams packed{1,4*valid_*t_.input_width,0,0,0};const DataCopyPadExtParams<float>noPad{false,0,0,0.0f};DataCopyPad(dense_output_,input_[first*t_.input_width],packed,noPad);if(!constants_ready_){Duplicate(denom_,0.0f,rp_+64);Duplicate(ones_,1.0f,ones_cap_+64);Duplicate(dense_output_[zero_offset_],0.0f,8);SN_VB;constants_ready_=true;}if(t_.h<16){Duplicate(matrix_[rows_*t_.h_pad],0.0f,(16-t_.h)*span_+64);SN_VB;}if(input_indexed_valid_!=valid_){BuildDenseInputMaps();input_indexed_valid_=valid_;}Sync<HardEvent::MTE2_V>();auto index=input_index_.template ReinterpretCast<SN_U32>();Gather(gates_,dense_output_,index,SN_U32{0},2*span_);Gather(matrix_,dense_output_,index[2*span_],SN_U32{0},t_.h*span_);SN_VB;}SN_AI void GatesAndRowMax(){Muls(tmp_,gates_,-1.0f,2*span_);if ASCEND_IS_AIV{auto*matrix=SN_RC<SN_UB*>(matrix_.GetPhyAddr());auto*partial=SN_RC<SN_UB*>(partial_.GetPhyAddr());auto*denom=SN_RC<SN_UB*>(denom_.GetPhyAddr());const SN_U64 live=((SN_U64{1}<<t_.h)-1)*
