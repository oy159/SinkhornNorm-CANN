template <HardEvent event>
__aicore__ inline void Sync(){const auto id = pipe_.FetchEventID(event);SetFlag<event>(id);WaitFlag<event>(id);}__aicore__ inline void CopyIn(uint64_t first){const DataCopyExtParams gate{static_cast<uint16_t>(valid_),4 * t_.h,4 * (t_.input_width - t_.h),0,0};const DataCopyPadExtParams<float> noPad{false,0,0,0.0f};const uint64_t base = first * t_.input_width;DataCopyPad(gates_,input_[base],gate,noPad);DataCopyPad(gates_[span_],input_[base + t_.h],gate,noPad);const uint32_t area = t_.h * t_.h;if (partialB_ / sizeof(float)>= 2 * area && valid_ > 1){const DataCopyExtParams dense{1,4 * area,0,0,0};Sync<HardEvent::V_MTE2>();DataCopyPad(part_,input_[base + 2 * t_.h],dense,noPad);Sync<HardEvent::MTE2_V>();for (uint32_t token = 0;token < valid_;++token){if (token + 1 < valid_){Sync<HardEvent::V_MTE2>();DataCopyPad(part_[((token + 1)& 1)* area],input_[base + (token + 1)* t_.input_width + 2 * t_.h],dense,noPad);}if (token == 0)Gates();for (uint32_t block = 0;block < t_.h / 8;++block)
WideCopy8(
