SN_SC<std::SN_U64>(problem.shape[1]);const auto core_count=
std::min(token_count,SN_SC<std::SN_U64>(platform.aiv_cores));const auto tokens_per_core=token_count/core_count;const auto extra_core_count=token_count%core_count;const auto max_core_tokens=tokens_per_core +(extra_core_count!=0 ? 1:0);const auto h_pad=(h+7)/8*8;const bool narrow_single_p24=
h>=17&&h<=24&&h_pad==24&&problem.iters>=2&&
HasBoundedReductionEpsilon(h,problem.eps)&&token_count==core_count;const auto minimum_general=
GetGeneralBufferSizes(1,h,h_pad,input_width,narrow_single_p24);if(minimum_general.Total()>platform.ub_bytes){return reject("UB capacity cannot hold one complete token, scratch, and "
"8192 reserved bytes");}bool use_interleaved=false;std::SN_U64 selected_tile=1;BufferSizes selected_sizes=minimum_general;if(IsEstablishedInterleavedWorkload(h,problem.iters,tokens_per_core,problem.eps)&&
