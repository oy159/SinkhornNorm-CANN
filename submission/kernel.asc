namespace sinkhorn_norm {namespace kernels {using namespace AscendC;__aicore__ inline uint32_t GetCompactPlaneCapacity(const sinkhorn_norm::TilingData &t){const uint64_t h = t.h;const uint64_t gather_limit = (255 / (h * h))* 64;const uint64_t width = h * (h + 2);const uint64_t plane_capacity = t.input_bytes / (4 * width);const bool plane_budget =
