class GeneralFallbackKernel {public:
__aicore__ inline void Init(GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,const TilingData &tiling){t_ = tiling;const uint64_t core = GetBlockIdx();start_ = core * t_.tokens_per_core +
