// Independent cloud harness. Includes the exact exported contest implementation.
#include <algorithm>
#include <cstdint>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <iomanip>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "../submission/kernel.asc"

namespace {
void Check(aclError code) {
    if (code != ACL_SUCCESS) throw std::runtime_error("ACL error " + std::to_string(code));
}
struct Session {
    int device;
    bool initialized = false, selected = false;
    aclrtStream stream = nullptr;
    explicit Session(int id) : device(id) {
        Check(aclInit(nullptr)); initialized = true;
        Check(aclrtSetDevice(device)); selected = true;
        Check(aclrtCreateStream(&stream));
    }
    ~Session() {
        if (stream) aclrtDestroyStream(stream);
        if (selected) aclrtResetDevice(device);
        if (initialized) aclFinalize();
    }
};
struct Buffer {
    static constexpr size_t guard = 64;
    static constexpr unsigned char pattern = 0xA5;
    void* base = nullptr;
    uint8_t* data = nullptr;
    size_t bytes;
    // Fixed, shape-independent layout matching the measured diagnostic shift0.
    static constexpr size_t allocationExtra = 1024;
    static constexpr size_t prefix = 512;
    explicit Buffer(size_t size) : bytes(size) {
        if (bytes > std::numeric_limits<size_t>::max() - allocationExtra)
            throw std::runtime_error("invalid allocation size");
        Check(aclrtMalloc(&base, bytes + allocationExtra, ACL_MEM_MALLOC_HUGE_FIRST));
        data = static_cast<uint8_t*>(base) + prefix;
        Check(aclrtMemset(base, bytes + allocationExtra, pattern, bytes + allocationExtra));
    }
    Buffer(const Buffer&) = delete;
    ~Buffer() { if (base) aclrtFree(base); }
    void checkGuards() const {
        unsigned char actual[guard];
        for (const void* address : {static_cast<void*>(data - guard),
                                   static_cast<void*>(data + bytes)}) {
            Check(aclrtMemcpy(actual, guard, address, guard, ACL_MEMCPY_DEVICE_TO_HOST));
            for (auto value : actual)
                if (value != pattern) throw std::runtime_error("device buffer guard damaged");
        }
    }
    void writeMetadata(std::ostream& stream) const {
        const auto baseAddress = reinterpret_cast<uintptr_t>(base);
        const auto dataAddress = reinterpret_cast<uintptr_t>(data);
        stream << "{\"bytes\":" << bytes
               << ",\"allocation_bytes\":" << bytes + allocationExtra
               << ",\"base_uintptr\":" << baseAddress
               << ",\"data_uintptr\":" << dataAddress
               << ",\"data_offset\":" << dataAddress - baseAddress
               << ",\"front_guard_uintptr\":" << dataAddress - guard
               << ",\"back_guard_uintptr\":" << dataAddress + bytes;
        for (const uintptr_t alignment : {uintptr_t{128}, uintptr_t{256},
                                         uintptr_t{512}, uintptr_t{4096}}) {
            stream << ",\"base_mod" << alignment << "\":" << baseAddress % alignment
                   << ",\"data_mod" << alignment << "\":" << dataAddress % alignment;
        }
        stream << '}';
    }
    void save(const std::filesystem::path& path) const {
        constexpr size_t chunk = 4 * 1024 * 1024;
        std::vector<char> host(std::min(bytes, chunk));
        std::ofstream file(path, std::ios::binary);
        for (size_t offset = 0; offset < bytes; offset += host.size()) {
            const auto count = std::min(host.size(), bytes - offset);
            Check(aclrtMemcpy(host.data(), count, data + offset, count, ACL_MEMCPY_DEVICE_TO_HOST));
            file.write(host.data(), count);
        }
        if (!file) throw std::runtime_error("output write failed");
    }
};
void TransferInput(Buffer& input, const std::filesystem::path& path, bool verify) {
    if (std::filesystem::file_size(path) != input.bytes)
        throw std::runtime_error("input file length mismatch");
    std::ifstream file(path, std::ios::binary);
    constexpr size_t chunk = 4 * 1024 * 1024;
    std::vector<char> expected(std::min(input.bytes, chunk)), actual(expected.size());
    for (size_t offset = 0; offset < input.bytes; offset += expected.size()) {
        const auto count = std::min(expected.size(), input.bytes - offset);
        if (!file.read(expected.data(), count)) throw std::runtime_error("input read failed");
        if (verify) {
            Check(aclrtMemcpy(actual.data(), count, input.data + offset, count, ACL_MEMCPY_DEVICE_TO_HOST));
            if (std::memcmp(expected.data(), actual.data(), count))
                throw std::runtime_error("operator modified input");
        } else {
            Check(aclrtMemcpy(input.data + offset, count, expected.data(), count, ACL_MEMCPY_HOST_TO_DEVICE));
        }
    }
}
int Integer(const char* value) {
    size_t used = 0;
    const auto result = std::stoi(value, &used);
    if (used != std::strlen(value) || result < 0) throw std::runtime_error("invalid integer");
    return result;
}
} // namespace

int main(int argc, char** argv) {
    try {
        if (argc == 2 && std::string(argv[1]) == "--revision") {
            std::cout << SINKHORN_TEST_REVISION << '\n';
            return 0;
        }
        if (argc != 6) throw std::runtime_error("usage: sinkhorn_tb FIXTURE OUTPUT DEVICE WARMUP TESTS");
        const std::filesystem::path fixture = argv[1], output = argv[2];
        const int device = Integer(argv[3]), warmup = Integer(argv[4]), tests = Integer(argv[5]);
        if (tests < 1 || tests > 5000 || warmup > 1000) throw std::runtime_error("invalid launch counts");
        sinkhorn_norm::Problem problem;
        std::ifstream spec(fixture / "case.spec");
        if (!(spec >> problem.shape[0] >> problem.shape[1] >> problem.h >> problem.iters >> problem.eps))
            throw std::runtime_error("invalid case.spec");
        std::string extra;
        if (spec >> extra) throw std::runtime_error("unexpected case.spec field");
        if (problem.h < 2 || problem.h > 128) throw std::runtime_error("invalid H");
        problem.shape[2] = problem.h * (problem.h + 2);
        Session session(device);
        int64_t cores = 0;
        Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores));
        if (cores <= 0) throw std::runtime_error("no vector cores");
        sinkhorn_norm::PlatformResources resources;
        sinkhorn_norm::LaunchPlan measuredPlan;
        sinkhorn_norm::OutputShapes shapes;
        std::string error;
        if (!sinkhorn_norm::QueryPlatformResources(resources, error)) throw std::runtime_error(error);
        resources.aiv_cores = static_cast<uint32_t>(std::min<uint64_t>(resources.aiv_cores, cores));
        if (!sinkhorn_norm::MakeLaunchPlan(problem, resources, measuredPlan, shapes, error)) throw std::runtime_error(error);
        const auto &tiling = measuredPlan.data;
        const size_t gateBytes = tiling.token_count * tiling.h * sizeof(float);
        Buffer mixes(tiling.token_count * tiling.input_width * sizeof(float));
        Buffer pre(gateBytes), post(gateBytes), comb(gateBytes * tiling.h);
        TransferInput(mixes, fixture / "mixes.bin", false);
        const int64_t inputShape[] = {problem.shape[0], problem.shape[1], problem.shape[2]};
        TensorInfo tensor[] = {{inputShape, 3, 0}, {shapes.pre, 3, 0},
                              {shapes.post, 3, 0}, {shapes.comb, 4, 0}};
        auto launch = [&] {
            run_kernel(mixes.data, {tensor, 1}, pre.data, {tensor + 1, 1},
                       post.data, {tensor + 2, 1}, comb.data, {tensor + 3, 1},
                       cores, session.stream, problem.h, problem.iters, problem.eps);
            Check(aclrtSynchronizeStream(session.stream));
        };
        for (int i = 0; i < warmup; ++i) launch();
        for (int i = 0; i < tests; ++i) launch();
        // Transfers/checks are outside all operator invocations; no host timer.
        mixes.checkGuards(); pre.checkGuards(); post.checkGuards(); comb.checkGuards();
        TransferInput(mixes, fixture / "mixes.bin", true);
        std::filesystem::create_directories(output);
        pre.save(output / "pre.bin"); post.save(output / "post.bin"); comb.save(output / "comb.bin");
        std::ofstream metadata(output / "completion.json");
        metadata << "{\"code_version\":\"" << SINKHORN_TEST_REVISION << "\",\"launches\":" << warmup + tests << ",\"warmup\":" << warmup
                 << ",\"tests\":" << tests << ",\"cores\":" << tiling.core_count << ",\"launch_blocks\":" << measuredPlan.blocks
                 << ",\"tile_tokens\":" << tiling.tile_tokens << ",\"ub_bytes\":" << resources.ub_bytes
                 << ",\"queried_aiv_cores\":" << resources.aiv_cores;
#ifdef SINKHORN_CUBE_BATCH_LAYOUT
        metadata << ",\"cube_batch_tokens\":"
                 << (sinkhorn_norm::UsesCubeBatchLayout(tiling) ? tiling.tile_tokens : 0)
                 << ",\"queried_resource_budgets\":{\"aiv_cores\":" << resources.aiv_cores
                 << ",\"aic_cores\":" << resources.aic_cores
                 << ",\"ub_bytes\":" << resources.ub_bytes
                 << ",\"l1_bytes\":" << resources.l1_bytes
                 << ",\"l0a_bytes\":" << resources.l0a_bytes
                 << ",\"l0b_bytes\":" << resources.l0b_bytes
                 << ",\"l0c_bytes\":" << resources.l0c_bytes << '}';
#endif
        metadata << std::setprecision(std::numeric_limits<float>::max_digits10)
                 << ",\"protocol_version\":\"sinkhorn-testbench-gm512-v1\""
                 << ",\"gm_data_offset_bytes\":" << Buffer::prefix
                 << ",\"guard_bytes\":" << Buffer::guard
                 << ",\"shape\":[" << problem.shape[0] << ',' << problem.shape[1]
                 << ',' << problem.shape[2] << ']'
                 << ",\"h\":" << problem.h << ",\"iters\":" << problem.iters
                 << ",\"eps\":" << problem.eps
                 << ",\"available_core_limit\":" << cores
                 << ",\"tokens_per_core\":" << tiling.tokens_per_core
                 << ",\"extra_core_count\":" << tiling.extra_core_count
                 << ",\"h_pad\":" << tiling.h_pad
                 << ",\"tiling_buffers\":{\"input_bytes\":" << tiling.input_bytes
                 << ",\"matrix_bytes\":" << tiling.matrix_bytes
                 << ",\"gate_bytes\":" << tiling.gate_bytes
                 << ",\"scratch_bytes\":" << tiling.scratch_bytes << '}'
                 << ",\"buffers\":{\"mixes\":";
        mixes.writeMetadata(metadata);
        metadata << ",\"pre\":"; pre.writeMetadata(metadata);
        metadata << ",\"post\":"; post.writeMetadata(metadata);
        metadata << ",\"comb\":"; comb.writeMetadata(metadata);
        metadata << "},\"input_unchanged\":true,\"guards_passed\":true}\n";
        if (!metadata) throw std::runtime_error("metadata write failed");
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "TESTBENCH ERROR: " << error.what() << '\n';
        return 2;
    }
}
